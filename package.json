{
  "name": "pranshul-chandhok-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:build": "node scripts/verify-build.mjs",
    "media:career:inspect": "node scripts/prepare-career-media.mjs --inspect",
    "media:career:build": "node scripts/prepare-career-media.mjs --build",
    "verify": "npm run check && npm test && npm run test:e2e && npm run build && npm run test:build",
    "deploy": "npm run verify && gh-pages -d dist -b gh-pages --dotfiles"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "axe-core": "4.13.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gh-pages": "6.3.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
