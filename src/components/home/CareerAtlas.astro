---
import type { CollectionEntry } from 'astro:content';
import { CAREER_DOMAIN_META, CAREER_ERA_META } from '../../data/career-domains';
import { CAREER_MEDIA } from '../../data/career-media';
import type { CareerDomain, CareerEra } from '../../content/evidence';

interface Props {
  work: CollectionEntry<'work'>[];
}

const { work } = Astro.props;
const records = [...work].sort((a, b) => a.data.careerOrder - b.data.careerOrder);
const domains = Object.entries(CAREER_DOMAIN_META).sort(([, a], [, b]) => a.order - b.order) as [CareerDomain, typeof CAREER_DOMAIN_META[CareerDomain]][];
const eras = Object.entries(CAREER_ERA_META).sort(([, a], [, b]) => a.order - b.order) as [CareerEra, typeof CAREER_ERA_META[CareerEra]][];
const featuredIndex = Math.max(0, records.findIndex((entry) => entry.data.slug === 'ira-vr'));
---

<section class="career-atlas" id="career-atlas" aria-labelledby="career-atlas-title" data-career-atlas data-default-career="ira-vr">
  <header class="career-atlas__header">
    <p class="career-atlas__kicker">Career Atlas · 2012—Now</p>
    <h2 id="career-atlas-title">Not a straight line.<br />A compounding practice.</h2>
    <p class="career-atlas__intro">Fifteen years of making unfamiliar technology useful—from game loops and immersive systems to design software and production AI. Select any point to see the evidence.</p>
  </header>

  <nav class="career-atlas__filters" aria-label="Filter career by domain">
    <button type="button" data-atlas-filter="all" aria-pressed="true"><span>All work</span><small>{records.length}</small></button>
    {domains.map(([key, domain]) => (
      <button type="button" data-atlas-filter={key} aria-pressed="false">
        <span>{domain.label}</span>
        <small>{records.filter((entry) => entry.data.domains.includes(key)).length}</small>
      </button>
    ))}
  </nav>

  <div class="career-atlas__field">
    <div class="career-atlas__map" aria-label="Career records by era">
      {eras.map(([eraKey, era], eraIndex) => {
        const eraRecords = records.filter((entry) => entry.data.era === eraKey);
        return (
          <section class="career-era" data-era={eraKey}>
            <header>
              <span aria-hidden="true">{String(eraIndex + 1).padStart(2, '0')}</span>
              <div>
                <h3>{era.label}</h3>
                <p>{era.description}</p>
              </div>
            </header>
            <div class="career-era__rail" role="group" aria-label={`${era.label} records`}>
              {eraRecords.map((entry, index) => (
                <button
                  type="button"
                  class="career-node"
                  data-atlas-node
                  data-slug={entry.data.slug}
                  data-domains={entry.data.domains.join(' ')}
                  data-relationships={entry.data.relationships.join(' ')}
                  aria-pressed={records.indexOf(entry) === featuredIndex ? 'true' : 'false'}
                  tabindex={records.indexOf(entry) === featuredIndex ? '0' : '-1'}
                  style={`--node-offset: ${index % 3}; --node-index: ${records.indexOf(entry)};`}
                >
                  <span class="career-node__year">{entry.data.yearStart}</span>
                  <span class="career-node__mark" aria-hidden="true"></span>
                  <span class="career-node__title">{entry.data.title}</span>
                </button>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <div class="career-atlas__stage" aria-live="polite">
      <div class="career-atlas__stage-toolbar">
        <span data-atlas-count>{String(featuredIndex + 1).padStart(2, '0')} / {String(records.length).padStart(2, '0')}</span>
        <div>
          <button type="button" data-atlas-previous aria-label="Previous career record">←</button>
          <button type="button" data-atlas-next aria-label="Next career record">→</button>
        </div>
      </div>
      {records.map((entry, index) => {
        const period = entry.data.yearEnd && entry.data.yearEnd !== entry.data.yearStart
          ? `${entry.data.yearStart}—${entry.data.yearEnd}`
          : String(entry.data.yearStart);
        const media = entry.data.heroMedia;
        const clipKey = entry.data.slug === 'mysticmojo' ? 'oye-tippa-run' : entry.data.slug;
        const clip = CAREER_MEDIA[clipKey]?.derivatives;
        const primaryDomain = CAREER_DOMAIN_META[entry.data.domains[0]];
        return (
          <article
            class:list={['career-atlas__panel', !media && 'career-atlas__panel--typographic']}
            data-atlas-panel
            data-slug={entry.data.slug}
            hidden={index !== featuredIndex}
            aria-hidden={index !== featuredIndex ? 'true' : 'false'}
          >
            <div class="career-atlas__media">
              {media && clip?.clipMp4 ? (
                <video controls muted playsinline preload="none" poster={media.src} aria-label={media.alt}>
                  {clip.clipWebm && <source src={clip.clipWebm} type="video/webm" />}
                  <source src={clip.clipMp4} type="video/mp4" />
                </video>
              ) : media ? (
                <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" decoding="async" />
              ) : (
                <div class="career-atlas__monogram" aria-hidden="true">
                  <span>{entry.data.title.slice(0, 2)}</span>
                  <small>{period}</small>
                </div>
              )}
              <p><span>{entry.data.heroLabel ? `${primaryDomain.label} · ${entry.data.heroLabel}` : primaryDomain.label}</span><span>{entry.data.evidenceStatus.replaceAll('-', ' ')}</span></p>
            </div>
            <div class="career-atlas__panel-copy">
              <p class="career-atlas__period">{period} · {entry.data.role}</p>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.summary}</p>
              <div class="career-atlas__panel-actions">
                <a href={`/work/${entry.data.slug}/`}>Open the record <span aria-hidden="true">↗</span></a>
                <a href={entry.data.sources[0].url} rel="noreferrer">Primary evidence <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <div class="career-atlas__index">
    <p>Complete public record</p>
    <ol>
      {records.map((entry) => (
        <li>
          <span>{entry.data.yearStart}</span>
          <a href={`/work/${entry.data.slug}/`}>{entry.data.title}</a>
          <small>{entry.data.role}</small>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { initCareerAtlas } from '../../scripts/career-atlas';
  initCareerAtlas();
  document.addEventListener('astro:after-swap', initCareerAtlas);
</script>

<style>
  .career-atlas {
    position: relative;
    padding: clamp(6rem, 12vw, 11rem) var(--page-gutter);
    overflow: clip;
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }

  .career-atlas::before {
    position: absolute;
    top: clamp(16rem, 26vw, 24rem);
    right: -18vw;
    z-index: -1;
    width: 64vw;
    height: 64vw;
    border: 1px solid color-mix(in srgb, var(--cobalt) 32%, transparent);
    border-radius: 50%;
    content: '';
    opacity: 0.5;
    transform: rotate(-12deg) scaleY(0.28);
  }

  .career-atlas__header {
    display: grid;
    grid-template-columns: 0.46fr 1.5fr 0.72fr;
    gap: clamp(1.5rem, 4vw, 5rem);
    align-items: end;
  }

  .career-atlas__kicker {
    align-self: start;
    color: var(--cobalt);
    font-size: 0.76rem;
    font-weight: 760;
  }

  .career-atlas__header h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 6.8vw, 6rem);
  }

  .career-atlas__intro {
    max-width: 33ch;
    margin: 0 0 0.45rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .career-atlas__filters {
    display: flex;
    margin-top: clamp(3rem, 6vw, 5.5rem);
    overflow-x: auto;
    border-block: 1px solid var(--line);
    scrollbar-width: thin;
  }

  .career-atlas__filters button {
    display: flex;
    min-width: max-content;
    min-height: 3.8rem;
    padding: 0.85rem clamp(0.85rem, 2vw, 1.5rem);
    align-items: center;
    gap: 0.8rem;
    border: 0;
    border-right: 1px solid var(--line);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 680;
  }

  .career-atlas__filters button[aria-pressed='true'] {
    background: var(--text);
    color: var(--surface);
  }

  .career-atlas__filters small {
    color: color-mix(in srgb, currentColor 60%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .career-atlas__field {
    display: grid;
    min-height: 48rem;
    grid-template-columns: minmax(0, 0.78fr) minmax(29rem, 1.22fr);
    border-bottom: 1px solid var(--line);
  }

  .career-atlas__map {
    padding: clamp(2.5rem, 5vw, 5rem) clamp(1.25rem, 4vw, 4rem) clamp(2.5rem, 5vw, 5rem) 0;
    border-right: 1px solid var(--line);
  }

  .career-era {
    display: grid;
    grid-template-columns: minmax(10rem, 0.5fr) minmax(16rem, 1.5fr);
    gap: clamp(1rem, 3vw, 3rem);
    padding: 1.3rem 0 2.3rem;
  }

  .career-era + .career-era { border-top: 1px solid var(--line); }

  .career-era > header {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.7rem;
  }

  .career-era > header > span {
    color: var(--cobalt);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    font-weight: 760;
  }

  .career-era h3 {
    max-width: 15ch;
    margin-bottom: 0.65rem;
    font-size: clamp(1.15rem, 1.8vw, 1.7rem);
    line-height: 1.05;
  }

  .career-era header p {
    max-width: 28ch;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .career-era__rail {
    position: relative;
    display: grid;
    align-content: start;
  }

  .career-era__rail::before {
    position: absolute;
    top: 1.34rem;
    left: 0.22rem;
    width: 1px;
    height: calc(100% - 2.68rem);
    background: var(--line);
    content: '';
  }

  .career-node {
    position: relative;
    display: grid;
    min-height: 3.3rem;
    padding: 0.5rem 0.6rem 0.5rem calc(2rem + (var(--node-offset) * 0.45rem));
    grid-template-columns: 3.2rem 1fr;
    gap: 0.65rem;
    align-items: center;
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    text-align: left;
  }

  .career-node[hidden] { display: none; }

  .career-node__mark {
    position: absolute;
    left: calc(0.22rem + (var(--node-offset) * 0.45rem));
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--text);
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 0.35rem 0.8rem color-mix(in srgb, var(--ink) 10%, transparent);
    transition: transform 300ms var(--ease-out), background-color 180ms ease;
  }

  .career-node__year {
    color: var(--text-muted);
    font-size: 0.67rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .career-node__title {
    font-size: 0.78rem;
    font-weight: 680;
    line-height: 1.15;
  }

  .career-node:hover .career-node__mark,
  .career-node[aria-pressed='true'] .career-node__mark {
    background: var(--cobalt);
    border-color: var(--cobalt);
    transform: scale(1.65);
  }

  .career-node[aria-pressed='true'] .career-node__title { color: var(--cobalt); }

  .career-atlas__stage {
    position: sticky;
    top: 0;
    align-self: start;
    min-height: 48rem;
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(2rem, 4vw, 4rem) clamp(1.5rem, 4vw, 4rem);
  }

  .career-atlas__stage-toolbar {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    font-weight: 760;
  }

  .career-atlas__stage-toolbar div { display: flex; gap: 0.45rem; }

  .career-atlas__stage-toolbar button {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .career-atlas__stage-toolbar button:disabled { color: var(--fog); cursor: not-allowed; }
  .career-atlas__panel[hidden] { display: none; }

  .career-atlas__panel {
    animation: atlas-reveal 520ms var(--ease-out) both;
  }

  .career-atlas__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 1.4rem 3.2rem color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .career-atlas__media img,
  .career-atlas__media video { width: 100%; height: 100%; object-fit: cover; }

  .career-atlas__media > p {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    margin: 0;
    padding: 0.75rem 0.9rem;
    justify-content: space-between;
    gap: 1rem;
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    color: var(--paper);
    font-size: 0.61rem;
    font-weight: 700;
    text-transform: capitalize;
  }

  .career-atlas__monogram {
    display: grid;
    height: 100%;
    padding: 1.5rem;
    grid-template-rows: 1fr auto;
    align-items: center;
    background:
      radial-gradient(circle at 78% 22%, color-mix(in srgb, var(--cobalt) 65%, transparent), transparent 30%),
      var(--ink);
  }

  .career-atlas__monogram > span {
    font-size: clamp(8rem, 16vw, 15rem);
    font-stretch: 78%;
    font-weight: 850;
    letter-spacing: -0.04em;
    line-height: 0.68;
    text-transform: uppercase;
  }

  .career-atlas__monogram small { justify-self: end; font-size: 0.7rem; }

  .career-atlas__panel-copy { padding: 1.65rem 0 0; }
  .career-atlas__period { margin-bottom: 0.65rem; color: var(--cobalt); font-size: 0.67rem; font-weight: 720; }
  .career-atlas__panel-copy h3 { margin-bottom: 0.8rem; font-size: clamp(2rem, 3.8vw, 3.6rem); }
  .career-atlas__panel-copy > p:not(.career-atlas__period) { max-width: 48ch; color: var(--text-muted); font-size: 0.82rem; }

  .career-atlas__panel-actions { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 1.3rem; }
  .career-atlas__panel-actions a { font-size: 0.72rem; font-weight: 720; }

  .career-atlas__index { padding-top: clamp(4rem, 8vw, 7rem); }
  .career-atlas__index > p { color: var(--text-muted); font-size: 0.72rem; }
  .career-atlas__index ol { margin: 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .career-atlas__index li { display: grid; padding: 0.9rem 0; grid-template-columns: 5rem 1fr 0.8fr; gap: 1rem; border-bottom: 1px solid var(--line); font-size: 0.76rem; }
  .career-atlas__index li > span { color: var(--cobalt); font-variant-numeric: tabular-nums; }
  .career-atlas__index li > a { font-weight: 720; }
  .career-atlas__index li > small { color: var(--text-muted); }
  .career-atlas--enhanced .career-atlas__index { margin-top: 2rem; }

  @keyframes atlas-reveal {
    from { opacity: 0.5; filter: blur(0.45rem); clip-path: inset(0 0 11% 0); transform: translateY(1rem); }
    to { opacity: 1; filter: blur(0); clip-path: inset(0); transform: translateY(0); }
  }

  @media (max-width: 64rem) {
    .career-atlas__header { grid-template-columns: 1fr 2fr; }
    .career-atlas__intro { grid-column: 2; }
    .career-atlas__field { grid-template-columns: 1fr; }
    .career-atlas__map { border-right: 0; padding-right: 0; }
    .career-atlas__stage { position: relative; min-height: auto; padding-left: 0; border-top: 1px solid var(--line); order: -1; }
    .career-atlas__media { aspect-ratio: 16 / 9; }
  }

  @media (max-width: 42rem) {
    .career-atlas__header { grid-template-columns: 1fr; }
    .career-atlas__intro { grid-column: auto; }
    .career-atlas__header h2 { font-size: clamp(2.8rem, 14vw, 4.4rem); }
    .career-era { grid-template-columns: 1fr; }
    .career-era > header { grid-template-columns: 1.75rem 1fr; }
    .career-era__rail { padding-left: 0.5rem; }
    .career-atlas__media { aspect-ratio: 4 / 3; }
    .career-atlas__index li { grid-template-columns: 3.5rem 1fr; }
    .career-atlas__index li > small { grid-column: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .career-atlas__panel { animation: none; }
    .career-node__mark { transition: none; }
  }

  @media (forced-colors: active) {
    .career-atlas::before,
    .career-era__rail::before { display: none; }
    .career-atlas__filters button[aria-pressed='true'],
    .career-node[aria-pressed='true'] { outline: 2px solid CanvasText; outline-offset: -2px; }
  }
</style>
