---
import type { CollectionEntry } from 'astro:content';
import { MEDIA_PROVENANCE } from '../../data/media-provenance';
import { getNoteReadingTime, NOTE_TYPES } from '../../data/notes';

interface Props { work: CollectionEntry<'work'>[]; notes: CollectionEntry<'notes'>[]; }
const { work, notes } = Astro.props;
const motion: Record<string, string> = {
  designesto: '/media/work/blocks-inco-ai/designesto-edit-room.mp4',
  'homelane-spacecraft-pro': '/media/work/homelane-spacecraft-pro/room-editor-loop.mp4',
  'enterprise-immersive-systems': '/media/work/enterprise-immersive-systems/facility-loop.mp4',
};
const displayTitles: Record<string, string> = {
  'homelane-spacecraft-pro': 'SpaceCraft Pro',
  'enterprise-immersive-systems': 'Enterprise XR',
};
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }).format(date);
const proof = [
  { title: '14+ years', detail: 'Games, XR, design software and AI', href: '/about/' },
  { title: 'Founder → VP', detail: 'Building companies and leading teams', href: '/work/greykernel/' },
  { title: 'Patent co-inventor', detail: 'Humanoid robot control', href: '/work/humanoid-robot-control-system/' },
  { title: 'Still shipping', detail: 'Independent builds and experiments', href: '/lab/' },
];
---

<section class="home-proof" aria-label="Experience at a glance">
  <ul>{proof.map(item => <li><a href={item.href}><strong>{item.title}</strong><span>{item.detail}</span></a></li>)}</ul>
</section>

<section class="velvet-work" id="selected-work" aria-labelledby="selected-work-title" data-signal-work>
  <header class="velvet-work__opening">
    <h2 id="selected-work-title">A closer look at <em>the work.</em></h2>
    <div><p>Five projects spanning design systems, applied AI and immersive training. Each page explains the product and my contribution.</p><a href="/work/">View all projects <span aria-hidden="true">→</span></a></div>
  </header>
  <div class="velvet-work__cases">
    {work.map(entry => {
      const media = entry.data.heroMedia;
      const mp4 = motion[entry.data.slug];
      const title = displayTitles[entry.data.slug] ?? entry.data.title;
      return (
        <article class="velvet-case" data-signal-case data-case-slug={entry.data.slug}>
          <div class="velvet-case__visual">
            <a class="velvet-case__media" href={`/work/${entry.data.slug}/`} aria-label={`View ${title}`}>
              {media && (mp4 ? (
                <video muted loop playsinline preload="none" poster={media.src} data-signal-video data-media-source-url={MEDIA_PROVENANCE[media.src]?.sourceUrl} data-media-source-status={MEDIA_PROVENANCE[media.src]?.status} aria-label={media.alt}>
                  <source src={mp4} type="video/mp4" />
                </video>
              ) : (
                <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" decoding="async" />
              ))}
              <span class="velvet-case__scan" aria-hidden="true"></span>
            </a>
            {mp4 && <button type="button" class="velvet-case__motion" data-signal-motion-toggle aria-label={`Play ${title} motion`} aria-pressed="false">
              <svg aria-hidden="true" data-signal-motion-icon viewBox="0 0 16 16" width="14" height="14"><path d="M5 3.5 12 8l-7 4.5Z" fill="currentColor" /></svg>
              <span data-signal-motion-label>Play</span>
            </button>}
          </div>
          <div class="velvet-case__copy">
            <h3>{title}</h3>
            <p class="velvet-case__phase">{entry.data.context ?? entry.data.status} · {entry.data.yearStart}</p>
            <p class="velvet-case__statement">{entry.data.summary}</p>
            <p class="velvet-case__role"><span>My role</span>{entry.data.role}</p>
            <a class="velvet-case__link" href={`/work/${entry.data.slug}/`} aria-label={`Read about ${title}`}>Read about the project <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      );
    })}
  </div>
</section>

<section class="workflow-thesis" aria-labelledby="workflow-thesis-title">
  <h2 id="workflow-thesis-title">Generation is the demo. <em>The workflow is the product.</em></h2>
  <div class="workflow-thesis__copy">
    <p>A generated image can start a conversation. The product needs to keep track of the room, the constraints and the choices someone has already approved.</p>
    <p>In <a href="/work/designesto/">Designesto</a>, that means revising a space without losing its intent. In <a href="/work/blocks/">Blocks</a>, a design choice has to stay connected to dimensions, price and production. The initial <a href="/work/propvr-ai-craft/">PropVR AI MVP</a> organised specialist tools around the task and the next decision.</p>
    <a class="text-link" href="/notes/generative-and-deterministic-systems/">Read the product argument <span aria-hidden="true">↗</span></a>
  </div>
</section>

<section class="home-notes" aria-labelledby="home-notes-title">
  <header><h2 id="home-notes-title">Writing</h2><a class="text-link" href="/notes/">All notes <span aria-hidden="true">→</span></a></header>
  <div class="home-notes__list">
    {notes.map(note => <article>
      <div class="home-notes__meta"><span>{NOTE_TYPES[note.data.type]}</span><time datetime={note.data.publishedAt.toISOString()}>{formatDate(note.data.publishedAt)}</time><span>{getNoteReadingTime(note.body ?? '')} min read</span></div>
      <div><h3><a href={`/notes/${note.data.slug}/`}>{note.data.title}</a></h3><p>{note.data.summary}</p></div>
    </article>)}
  </div>
</section>

<script>
  import { initSignalWork } from '../../scripts/signal-work';
  initSignalWork();
  document.addEventListener('astro:after-swap', initSignalWork);
</script>

<style>
  .home-proof, .velvet-work, .workflow-thesis, .home-notes { background: var(--velvet); color: var(--warm); }
  .home-proof { padding: 1.75rem var(--page-gutter); border-block: 1px solid var(--line); }
  .home-proof ul { display: grid; max-width: var(--content-width); grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; margin: 0 auto; padding: 0; list-style: none; }
  .home-proof a { display: grid; gap: 0.3rem; min-height: 3rem; color: var(--warm); text-decoration: none; }
  .home-proof strong { font-size: 1rem; font-weight: 720; }
  .home-proof span { color: var(--muted); font-size: 0.78rem; line-height: 1.45; }
  .home-proof a:hover strong { color: var(--gold); }
  .velvet-work__opening { padding: clamp(5rem, 10vw, 9rem) var(--page-gutter); }
  .velvet-work__opening h2 { max-width: 15ch; margin: 0; font-size: clamp(3.3rem, 7.7vw, 7rem); font-stretch: 78%; line-height: var(--leading-display); }
  .velvet-work__opening h2 em { color: var(--muted); font-style: normal; font-weight: 530; }
  .velvet-work__opening > div { display: grid; max-width: 48rem; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: end; margin: 3rem 0 0 auto; }
  .velvet-work__opening > div p { max-width: 40ch; margin: 0; color: var(--muted); }
  .velvet-work__opening > div > a { margin-inline-end: 3.5rem; }
  .velvet-work__opening > div a, .text-link { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 1rem; color: var(--gold); font-size: 0.75rem; font-weight: 700; text-underline-offset: 0.4em; }
  .velvet-work__cases { border-top: 1px solid var(--line); }
  .velvet-case { position: relative; display: grid; min-height: 40rem; grid-template-columns: minmax(0, 1.15fr) minmax(22rem, 0.85fr); border-bottom: 1px solid var(--line); background: #07090b; }
  .velvet-case:nth-child(even) { grid-template-columns: minmax(22rem, 0.85fr) minmax(0, 1.15fr); }
  .velvet-case:nth-child(even) .velvet-case__visual { grid-column: 2; grid-row: 1; }
  .velvet-case:nth-child(even) .velvet-case__copy { grid-column: 1; grid-row: 1; }
  .velvet-case__visual { position: relative; min-height: 30rem; overflow: hidden; background: var(--velvet-raised); }
  .velvet-case__media { position: absolute; inset: 0; display: block; overflow: hidden; }
  .velvet-case__media::after { position: absolute; inset: 0; background: linear-gradient(135deg, transparent 52%, rgb(3 4 5 / 0.35)); content: ''; pointer-events: none; }
  .velvet-case__media :is(video, img) { display: block; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85) contrast(1.04); transition: filter 550ms var(--ease-out), transform 900ms var(--ease-out); }
  [data-case-slug='propvr-ai-craft'] .velvet-case__media img { object-fit: contain; filter: none; }
  .velvet-case__media:hover :is(video, img), .velvet-case__media:focus-visible :is(video, img) { filter: none; transform: scale(1.02); }
  .velvet-case__scan { position: absolute; z-index: 2; inset: 0; border: 1px solid rgb(49 94 245 / 0.28); opacity: 0; transition: opacity 200ms ease, inset 450ms var(--ease-out); }
  .velvet-case__media:hover .velvet-case__scan, .velvet-case__media:focus-visible .velvet-case__scan { inset: 1rem; opacity: 1; }
  .velvet-case__copy { display: flex; min-width: 0; container-type: inline-size; padding: clamp(3rem, 5vw, 6rem) var(--page-gutter); flex-direction: column; justify-content: center; }
  .velvet-case h3 { max-width: 100%; margin: 0 0 1rem; font-size: clamp(2.75rem, 17cqi, 5.5rem); font-stretch: 78%; line-height: var(--leading-display); overflow-wrap: normal; text-wrap: balance; }
  .velvet-case__phase { margin: 0 0 2rem; color: var(--cobalt-bright); font-size: 0.74rem; line-height: 1.5; }
  .velvet-case__statement { max-width: 42ch; margin: 0; color: var(--muted); font-size: clamp(1rem, 1.2vw, 1.16rem); }
  .velvet-case__role { display: grid; max-width: 30rem; grid-template-columns: 4rem minmax(0, 1fr); gap: 1rem; margin: 2rem 0 0; padding-top: 0.75rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.875rem; line-height: 1.5; }
  .velvet-case__role span { color: var(--dim); text-transform: uppercase; }
  .velvet-case__link { display: inline-flex; width: fit-content; min-height: 2.75rem; align-items: center; gap: 0.8rem; margin-top: 1.5rem; border-bottom: 1px solid var(--gold); color: var(--warm); font-size: 0.67rem; font-weight: 720; letter-spacing: 0.06em; text-decoration: none; text-transform: uppercase; }
  .velvet-case__motion { position: absolute; z-index: 4; bottom: 1rem; left: 1rem; display: inline-flex; min-width: 5.5rem; min-height: 2.75rem; align-items: center; justify-content: center; gap: 0.45rem; border: 1px solid rgb(237 234 226 / 0.5); background: rgb(3 4 5 / 0.82); color: var(--warm); cursor: pointer; font-size: 0.65rem; text-transform: uppercase; }
  .velvet-case:nth-child(even) .velvet-case__motion { right: 1rem; left: auto; }
  .workflow-thesis { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(3rem, 8vw, 9rem); padding: clamp(6rem, 10vw, 10rem) var(--page-gutter); border-bottom: 1px solid var(--line); }
  .workflow-thesis h2 { max-width: 15ch; margin: 0; font-size: clamp(2.7rem, 4.6vw, 5rem); }
  .workflow-thesis h2 em { color: var(--muted); font-style: normal; }
  .workflow-thesis__copy { align-self: end; }
  .workflow-thesis__copy p { max-width: 53ch; color: var(--muted); }
  .workflow-thesis__copy p:first-child { margin-top: 0; }
  .workflow-thesis__copy p a { color: var(--warm); text-underline-offset: 0.2em; }
  .home-notes { padding: clamp(5rem, 9vw, 9rem) var(--page-gutter); }
  .home-notes > header { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 3rem; }
  .home-notes h2 { max-width: 12ch; margin: 0; font-size: clamp(2.7rem, 5vw, 5rem); }
  .home-notes__list { border-top: 1px solid var(--line-strong); }
  .home-notes article { display: grid; grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 1fr); gap: 3rem; padding-block: 2rem; border-bottom: 1px solid var(--line); }
  .home-notes__meta { display: flex; flex-direction: column; gap: 0.35rem; color: var(--muted); font-size: 0.78rem; }
  .home-notes__meta span:first-child { color: var(--gold); }
  .home-notes h3 { max-width: 35ch; margin: 0; font-size: clamp(1.5rem, 2.6vw, 2.5rem); }
  .home-notes h3 a { color: var(--warm); text-decoration: none; }
  .home-notes h3 a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .home-notes article p { max-width: 65ch; margin: 0.9rem 0 0; color: var(--muted); }
  @media (max-width: 64rem) {
    .velvet-case, .velvet-case:nth-child(even) { grid-template-columns: 1fr; }
    .velvet-case:nth-child(even) .velvet-case__visual, .velvet-case:nth-child(even) .velvet-case__copy { grid-column: 1; }
    .velvet-case:nth-child(even) .velvet-case__visual { grid-row: 1; }
    .velvet-case:nth-child(even) .velvet-case__copy { grid-row: 2; }
    .velvet-case__visual { aspect-ratio: 16 / 9; min-height: 0; }
    .velvet-case h3 { font-size: clamp(2.75rem, 11cqi, 5.5rem); }
    .workflow-thesis { grid-template-columns: 1fr; }
  }
  @media (max-width: 48rem) {
    .home-proof ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .velvet-work__opening > div { grid-template-columns: 1fr; }
    .velvet-case { min-height: 0; }
    .velvet-case__copy { padding-block: 3rem; }
    .velvet-case__visual { aspect-ratio: 4 / 3; }
    .home-notes > header { align-items: start; flex-direction: column; }
    .home-notes article { grid-template-columns: 1fr; gap: 1rem; }
    .home-notes__meta { flex-direction: row; flex-wrap: wrap; column-gap: 1rem; }
  }
  @media (max-width: 22rem) { .velvet-work__opening h2 { font-size: 3.15rem; } }
  @media (prefers-reduced-motion: reduce) { .velvet-case__media :is(video, img), .velvet-case__scan { transition: none; } }
</style>
