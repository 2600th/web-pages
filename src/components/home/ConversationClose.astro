---
import { CONTACT_EMAIL, CONVERSATION_PROMPTS } from '../../data/site';
---

<section class="conversation-close" id="contact" aria-labelledby="conversation-title">
  <p class="conversation-close__kicker">A useful first message</p>
  <h2 id="conversation-title">Bring me the problem that won’t stay in one discipline.</h2>
  <div class="conversation-close__details">
    <p>Tell me what is difficult, what has already been tried, and what a useful outcome would change. I’m based in Gurugram and work across product, technology, and implementation.</p>
    <p>Choose the closest context. Each path opens a direct email with enough signal to start well.</p>
  </div>
  <div class="conversation-close__action">
    <ul>
      {CONVERSATION_PROMPTS.map((prompt) => (
        <li>
          <a href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(prompt.subject)}`} data-event="contact_start" data-event-context={prompt.key}>
            <span><strong>{prompt.label}</strong><small>{prompt.detail}</small></span>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> · <a href="https://www.linkedin.com/in/pranshulchandhok/" target="_blank" rel="noopener">LinkedIn</a></p>
  </div>
</section>

<style>
  .conversation-close {
    display: grid;
    grid-template-columns: 0.58fr 1.65fr 0.8fr;
    gap: clamp(1.5rem, 4vw, 4.5rem);
    padding: clamp(5rem, 11vw, 10rem) var(--page-gutter);
    background: var(--cobalt);
    color: white;
  }
  .conversation-close__kicker { font-size: 0.75rem; font-weight: 720; }
  h2 { max-width: 12ch; margin: 0; font-size: clamp(3.2rem, 7vw, 6rem); }
  .conversation-close__details { padding-top: 0.35rem; font-size: 0.86rem; }
  .conversation-close__details p { max-width: 34ch; }
  .conversation-close__action { grid-column: 2 / -1; margin-top: clamp(3rem, 8vw, 7rem); }
  .conversation-close__action ul { margin: 0; padding: 0; list-style: none; }
  .conversation-close__action li { border-top: 1px solid white; }
  .conversation-close__action li:last-child { border-bottom: 1px solid white; }
  .conversation-close__action li > a {
    display: flex;
    min-height: 6rem;
    padding: 1.15rem 0;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    text-decoration: none;
    transition: transform 260ms var(--ease-out), background-color 180ms var(--ease-out);
  }
  .conversation-close__action li > a:hover { background: white; color: var(--cobalt); transform: translateX(0.5rem); }
  .conversation-close__action li strong,
  .conversation-close__action li small { display: block; }
  .conversation-close__action li strong { font-size: clamp(1rem, 2vw, 1.5rem); }
  .conversation-close__action li small { max-width: 62ch; margin-top: 0.35rem; font-size: 0.72rem; font-weight: 520; }
  .conversation-close__action > p { margin-top: 1rem; font-size: 0.74rem; }
  @media (max-width: 54rem) {
    .conversation-close { grid-template-columns: 1fr; }
    .conversation-close__details { max-width: 38rem; }
    .conversation-close__action { grid-column: 1; }
  }
  @media (max-width: 38rem) { .conversation-close__action li > a { min-height: 7rem; } }
</style>
