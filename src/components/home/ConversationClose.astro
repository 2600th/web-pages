---
import { CONTACT_EMAIL, CONVERSATION_PROMPTS } from '../../data/site';
---

<section class="conversation-close" id="contact" aria-labelledby="conversation-title">
  <p class="conversation-close__kicker">A useful first message</p>
  <h2 id="conversation-title">Bring me the problem that won’t stay in one discipline.</h2>
  <div class="conversation-close__details">
    <p>
      Tell me what is difficult, what has already been tried, and what a useful outcome would change. I’m based in Gurugram and work across product, technology, and implementation.
    </p>
    <ul>
      {CONVERSATION_PROMPTS.map((prompt) => <li>{prompt}</li>)}
    </ul>
  </div>
  <div class="conversation-close__action">
    <a href={`mailto:${CONTACT_EMAIL}`} data-event="contact_start" data-event-context="conversation_close">
      <span>Start a conversation</span>
      <strong>{CONTACT_EMAIL}</strong>
      <span aria-hidden="true">↗</span>
    </a>
    <a href="https://www.linkedin.com/in/pranshulchandhok/" target="_blank" rel="noopener">Or connect on LinkedIn</a>
  </div>
</section>

<style>
  .conversation-close {
    display: grid;
    grid-template-columns: 0.58fr 1.65fr 0.8fr;
    gap: clamp(1.5rem, 4vw, 4.5rem);
    padding: clamp(5rem, 11vw, 10rem) var(--page-gutter);
    background: var(--cobalt);
    color: white;
  }

  .conversation-close__kicker {
    font-size: 0.75rem;
    font-weight: 720;
  }

  h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3.2rem, 7vw, 6rem);
  }

  .conversation-close__details {
    padding-top: 0.35rem;
    font-size: 0.86rem;
  }

  .conversation-close__details p { max-width: 34ch; }

  .conversation-close__details ul {
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.4);
    list-style: none;
  }

  .conversation-close__details li {
    padding: 0.7rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    font-size: 0.72rem;
  }

  .conversation-close__action {
    grid-column: 2 / -1;
    margin-top: clamp(3rem, 8vw, 7rem);
  }

  .conversation-close__action > a:first-child {
    display: grid;
    padding: 1.25rem 0;
    grid-template-columns: 1fr auto auto;
    gap: 2rem;
    align-items: center;
    border-top: 1px solid white;
    border-bottom: 1px solid white;
    font-size: clamp(1rem, 2vw, 1.5rem);
    text-decoration: none;
    transition: padding 260ms var(--ease-out), background-color 180ms var(--ease-out);
  }

  .conversation-close__action > a:first-child:hover {
    padding-right: 1rem;
    padding-left: 1rem;
    background: white;
    color: var(--cobalt);
  }

  .conversation-close__action > a:last-child {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.74rem;
  }

  @media (max-width: 54rem) {
    .conversation-close { grid-template-columns: 1fr; }
    .conversation-close__details { max-width: 38rem; }
    .conversation-close__action { grid-column: 1; }
  }

  @media (max-width: 38rem) {
    .conversation-close__action > a:first-child {
      grid-template-columns: 1fr auto;
    }

    .conversation-close__action strong {
      grid-column: 1;
      grid-row: 2;
      font-size: 0.78rem;
    }

    .conversation-close__action > a:first-child > span:last-child {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>
