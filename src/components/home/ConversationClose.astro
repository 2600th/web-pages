---
import { CONTACT_EMAIL, CONVERSATION_PROMPTS } from '../../data/site';
---

<section class="conversation-close" id="contact" aria-labelledby="conversation-title" data-closing-plane="split">
  <div class="conversation-close__lead" data-polarity="positive">
    <h2 id="conversation-title">Bring the problem that won’t stay in one discipline.</h2>
    <p>Useful conversations usually begin with the difficult part: what has already been tried, where the system breaks, and what a better outcome would change.</p>
  </div>

  <div class="conversation-close__paths" data-polarity="negative">
    <ul>
      {CONVERSATION_PROMPTS.map((prompt) => (
        <li>
          <a href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(prompt.subject)}`} data-event="contact_start" data-event-context={prompt.key}>
            <span><strong>{prompt.label}</strong><small>{prompt.detail}</small></span>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
    <p>
      <a href={`mailto:${CONTACT_EMAIL}`} aria-label="Email Pranshul">{CONTACT_EMAIL}</a>
      <span>Gurugram · Working across product, technology, and implementation.</span>
    </p>
  </div>
</section>

<style>
  .conversation-close {
    /* Intentional close tokens: the final split remains calm while preserving a clear action hierarchy. */
    --type-close-title: clamp(3rem, 6.8vw, 6rem);
    --type-close-lead: 0.9rem;
    --type-close-prompt: clamp(1.1rem, 2vw, 1.6rem);
    --type-close-detail: 0.7rem;
    --type-close-footer: 0.72rem;
    display: grid;
    min-height: 75svh;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
    background: transparent;
    color: var(--negative);
  }

  .conversation-close__lead { display: flex; padding: clamp(3rem, 7vw, 7rem) var(--page-gutter); flex-direction: column; justify-content: space-between; border-right: 1px solid color-mix(in srgb, var(--negative) 24%, transparent); background: var(--positive); color: var(--negative); }
  h2 { max-width: 10ch; margin: 0; font-size: var(--type-close-title); }
  .conversation-close__lead p { max-width: 34ch; margin: 3rem 0 0; color: var(--graphite); font-size: var(--type-close-lead); }
  .conversation-close__paths { display: flex; padding: clamp(3rem, 7vw, 7rem) var(--page-gutter); flex-direction: column; justify-content: space-between; background: var(--negative); color: var(--positive); }
  ul { margin: 0; padding: 0; border-top: 1px solid color-mix(in srgb, var(--positive) 70%, transparent); list-style: none; }
  li { border-bottom: 1px solid color-mix(in srgb, var(--positive) 70%, transparent); }
  li > a { display: flex; min-height: 7rem; align-items: center; justify-content: space-between; gap: 2rem; text-decoration: none; transition: background-color 180ms var(--ease-out), color 180ms var(--ease-out), transform 240ms var(--ease-out); }
  li > a:hover { background: var(--positive); color: var(--negative); transform: translateX(0.35rem); }
  li strong,
  li small { display: block; }
  li strong { font-size: var(--type-close-prompt); }
  li small { max-width: 58ch; margin-top: 0.35rem; font-size: var(--type-close-detail); font-weight: 530; }
  .conversation-close__paths > p { display: flex; gap: 1rem 2rem; align-items: end; justify-content: space-between; margin: 4rem 0 0; font-size: var(--type-close-footer); }
  .conversation-close__paths > p a { font-weight: 760; }
  .conversation-close__paths > p span { max-width: 28ch; color: var(--fog); text-align: right; }
  @media (max-width: 54rem) {
    .conversation-close { min-height: auto; grid-template-columns: 1fr; }
    .conversation-close__lead { min-height: 0; padding-block: 3.25rem; border-right: 0; border-bottom: 1px solid color-mix(in srgb, var(--negative) 24%, transparent); }
    .conversation-close__paths { padding-block: 3rem; }
    li > a { min-height: 4.75rem; }
    .conversation-close__paths > p { margin-top: 2.5rem; }
  }
  @media (max-width: 36rem) {
    .conversation-close__paths > p { align-items: start; flex-direction: column; }
    .conversation-close__paths > p span { text-align: left; }
  }
</style>
