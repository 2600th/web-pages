---
import type { CollectionEntry } from 'astro:content';

interface Props {
  notes: CollectionEntry<'notes'>[];
}

const { notes } = Astro.props;
const recent = [...notes]
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<section class="recent-thinking" aria-labelledby="recent-thinking-title">
  <header>
    <p>Recent thinking</p>
    <h2 id="recent-thinking-title">Notes from the workbench.</h2>
    <a href="/notes/">All notes <span aria-hidden="true">↗</span></a>
  </header>
  <ol>
    {recent.map((note, index) => (
      <li>
        <a href={`/notes/${note.data.slug}/`}>
          <span class="note-index">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <time datetime={note.data.publishedAt.toISOString()}>{note.data.publishedAt.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</time>
            <h3>{note.data.title}</h3>
            <p>{note.data.summary}</p>
          </div>
          <span class="note-topic">{note.data.topics[0]}</span>
          <span class="note-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .recent-thinking {
    padding: clamp(5rem, 10vw, 9rem) var(--page-gutter);
    border-bottom: 1px solid var(--line);
  }

  header {
    display: grid;
    grid-template-columns: 0.55fr 1.7fr 0.8fr;
    gap: clamp(1.5rem, 4vw, 4.5rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  header > p {
    align-self: start;
    color: var(--signal);
    font-size: 0.75rem;
    font-weight: 720;
  }

  h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 6.2vw, 5.8rem);
  }

  header > a {
    justify-self: end;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
  }

  ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  li > a {
    display: grid;
    min-height: 12rem;
    padding: 1.4rem 0;
    grid-template-columns: 4rem minmax(0, 1.5fr) minmax(8rem, 0.5fr) 2rem;
    gap: 1.5rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: color 180ms var(--ease-out), transform 260ms var(--ease-out);
  }

  li > a:hover {
    color: var(--signal);
    transform: translateX(0.5rem);
  }

  .note-index,
  time,
  .note-topic {
    color: var(--text-muted);
    font-size: 0.68rem;
  }

  h3 {
    max-width: 25ch;
    margin: 0.6rem 0 0.8rem;
    font-size: clamp(1.55rem, 2.7vw, 2.55rem);
  }

  li p {
    max-width: 60ch;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .note-topic { padding-top: 0.1rem; }
  .note-arrow { justify-self: end; font-size: 1.15rem; }

  @media (max-width: 48rem) {
    header { grid-template-columns: 1fr; }
    header > a { justify-self: start; }

    li > a {
      grid-template-columns: 2rem 1fr 1.5rem;
      gap: 0.7rem;
    }

    .note-topic { display: none; }
  }
</style>
