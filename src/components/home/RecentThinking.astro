---
import type { CollectionEntry } from 'astro:content';

interface Props {
  notes: CollectionEntry<'notes'>[];
}

const { notes } = Astro.props;
const recent = [...notes]
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<section class="recent-thinking" id="recent-thinking" aria-labelledby="recent-thinking-title">
  <header>
    <h2 id="recent-thinking-title">Notes from the workbench.</h2>
    <div>
      <p>What becomes visible while building AI, browser-native 3D, games, and product systems.</p>
      <a href="/notes/">Read all notes <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <ol>
    {recent.map((note) => (
      <li>
        <a href={`/notes/${note.data.slug}/`}>
          <time datetime={note.data.publishedAt.toISOString()}>{note.data.publishedAt.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</time>
          <div>
            <h3>{note.data.title}</h3>
            <p>{note.data.summary}</p>
          </div>
          <span>{note.data.topics[0]}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .recent-thinking { padding: clamp(5rem, 10vw, 9rem) var(--page-gutter); }
  header { display: grid; max-width: var(--content-width); grid-template-columns: 1.35fr 0.65fr; gap: clamp(2rem, 6vw, 7rem); align-items: end; margin: 0 auto clamp(3rem, 6vw, 5rem); }
  h2 { max-width: 10ch; margin: 0; }
  header > div { display: grid; gap: 1rem; }
  header p { max-width: 34ch; margin: 0; color: var(--text-muted); }
  header a { width: max-content; min-height: 2.75rem; display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.76rem; font-weight: 740; }
  ol { max-width: var(--content-width); margin: 0 auto; padding: 0; border-top: 1px solid var(--line-strong); list-style: none; }
  li { border-bottom: 1px solid var(--line); }
  li > a { display: grid; min-height: 11rem; grid-template-columns: 8rem minmax(0, 1fr) minmax(8rem, 0.35fr) 1.5rem; gap: 1.5rem; align-items: start; padding: 1.6rem 0; text-decoration: none; transition: color 180ms var(--ease-out), transform 240ms var(--ease-out); }
  li > a:hover { color: var(--signal); transform: translateX(0.35rem); }
  time,
  li > a > span { color: var(--text-muted); font-size: 0.67rem; }
  h3 { max-width: 28ch; margin: 0 0 0.65rem; font-size: clamp(1.55rem, 2.6vw, 2.6rem); }
  li p { max-width: 64ch; margin: 0; color: var(--text-muted); font-size: 0.78rem; }
  li > a > span:last-child { justify-self: end; color: currentColor; }
  @media (max-width: 48rem) {
    .recent-thinking { padding-block: 4rem; }
    header { grid-template-columns: 1fr; margin-bottom: 2.5rem; }
    li > a { min-height: 0; grid-template-columns: 4.5rem 1fr 1rem; padding-block: 1.35rem; }
    li > a > span:nth-last-child(2) { display: none; }
  }
</style>
