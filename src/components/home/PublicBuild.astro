---
const builds = [
  { state: 'Active', name: 'Kinema', detail: 'Browser-native gameplay, rendering, physics, and level editing.', href: '/work/kinema/', external: false },
  { state: 'Shipped', name: 'Web Ocean 3D', detail: 'An inspectable real-time ocean experiment in the browser.', href: '/work/web-ocean-3d/', external: false },
  { state: 'Shipped', name: 'Safed Sagar', detail: 'A spatial field study carried from map to interactive surface.', href: '/work/safed-sagar/', external: false },
  { state: 'Source', name: 'GitHub', detail: 'Public repositories, workflows, and experiments behind the practice.', href: 'https://github.com/2600th', external: true },
  { state: 'Archived', name: 'Console archive', detail: 'The original terminal site remains available as a noindex archive.', href: '/lab/terminal/index.html', external: false },
] as const;
---

<section class="public-build" id="public-build" aria-labelledby="public-build-title">
  <div class="public-build__current" data-polarity="positive">
    <p class="public-build__state">Current build · launching in 2026</p>
    <h2 id="public-build-title">designesto.ai</h2>
    <p class="public-build__thesis">Generative AI becomes more useful when it stays inside the design workflow—editable, reviewable, and ready for the next decision.</p>
    <a class="public-build__case" href="/work/blocks-inco-ai/">Read the operating record <span aria-hidden="true">→</span></a>
  </div>

  <div class="public-build__ledger" data-polarity="negative">
    <header>
      <h3>Public build ledger</h3>
      <p>Source-visible work, current experiments, and the archive that documents where this practice came from.</p>
    </header>
    <nav aria-label="Public builds">
      {builds.map((build) => (
        <a data-build-row href={build.href} target={build.external ? '_blank' : undefined} rel={build.external ? 'noopener' : undefined}>
          <span class="public-build__row-state">{build.state}</span>
          <strong>{build.name}</strong>
          <span class="public-build__row-detail">{build.detail}</span>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </nav>
  </div>
</section>

<style>
  .public-build {
    /* Intentional ledger tokens: compact metadata stays readable on both polarity planes. */
    --build-meta-on-light: #4f514c;
    --build-meta-on-negative: #c2c3bc;
    --type-build-state: 0.66rem;
    --type-build-title: clamp(4rem, 7vw, 7.5rem);
    --type-build-thesis: clamp(1.05rem, 1.45vw, 1.35rem);
    --type-build-link: 0.72rem;
    --type-build-ledger-title: clamp(2.2rem, 4vw, 4.6rem);
    --type-build-ledger-body: 0.92rem;
    --type-build-row-state: 0.6rem;
    --type-build-row-name: clamp(1.15rem, 2vw, 1.75rem);
    --type-build-row-detail: 0.76rem;
    display: grid;
    grid-template-columns: minmax(20rem, 0.78fr) minmax(0, 1.22fr);
  }

  .public-build__current {
    display: flex;
    min-height: 44rem;
    padding: clamp(5rem, 9vw, 9rem) var(--page-gutter);
    flex-direction: column;
    justify-content: center;
    background: #f1f0ea;
    color: #080908;
  }

  .public-build__state {
    margin: 0 0 2rem;
    color: var(--build-meta-on-light);
    font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace;
    font-size: var(--type-build-state);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .public-build h2 {
    max-width: 8ch;
    margin: 0 0 1.3rem;
    font-size: var(--type-build-title);
    font-stretch: 78%;
    line-height: 0.82;
    overflow-wrap: anywhere;
  }

  .public-build__thesis {
    max-width: 30ch;
    margin: 0 0 3rem;
    font-size: var(--type-build-thesis);
    line-height: 1.45;
  }

  .public-build__case {
    display: inline-flex;
    width: max-content;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid currentColor;
    color: inherit;
    font-size: var(--type-build-link);
    font-weight: 740;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .public-build__case:hover {
    color: #2457ff;
  }

  .public-build__ledger {
    min-width: 0;
    padding: clamp(5rem, 9vw, 9rem) var(--page-gutter) 4rem;
    background: #080908;
    color: #f1f0ea;
  }

  .public-build__ledger header {
    display: grid;
    grid-template-columns: minmax(10rem, 0.6fr) minmax(12rem, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .public-build__ledger h3 {
    margin: 0;
    font-size: var(--type-build-ledger-title);
    line-height: 0.9;
  }

  .public-build__ledger header p {
    max-width: 34ch;
    margin: 0;
    color: #c2c3bc;
    font-size: var(--type-build-ledger-body);
    line-height: 1.45;
  }

  .public-build__ledger nav {
    border-top: 1px solid rgb(241 240 234 / 0.7);
  }

  .public-build__ledger nav a {
    display: grid;
    min-height: 5.75rem;
    grid-template-columns: 5.5rem minmax(8rem, 0.75fr) minmax(8rem, 1fr) 1rem;
    gap: 1rem;
    align-items: center;
    border-bottom: 1px solid rgb(241 240 234 / 0.27);
    color: inherit;
    text-decoration: none;
    transition: background-color 180ms var(--ease-out), color 180ms var(--ease-out), transform 180ms var(--ease-out);
  }

  .public-build__ledger nav a:hover,
  .public-build__ledger nav a:focus-visible {
    background: #f1f0ea;
    color: #080908;
    transform: translateX(0.35rem);
  }

  .public-build__row-state {
    color: var(--build-meta-on-negative);
    font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace;
    font-size: var(--type-build-row-state);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .public-build__ledger nav a:hover .public-build__row-state,
  .public-build__ledger nav a:focus-visible .public-build__row-state {
    color: #2457ff;
  }

  .public-build__ledger strong {
    font-size: var(--type-build-row-name);
    line-height: 1;
  }

  .public-build__row-detail {
    color: var(--build-meta-on-negative);
    font-size: var(--type-build-row-detail);
    line-height: 1.35;
  }

  .public-build__ledger nav a:hover .public-build__row-detail,
  .public-build__ledger nav a:focus-visible .public-build__row-detail {
    color: #4f514c;
  }

  .public-build__ledger i {
    justify-self: end;
    font-style: normal;
  }

  @media (max-width: 62rem) {
    .public-build {
      grid-template-columns: 1fr;
    }

    .public-build__current {
      min-height: 31rem;
    }

    .public-build__ledger {
      min-height: 0;
    }
  }

  @media (max-width: 42rem) {
    .public-build__current {
      min-height: 28rem;
      padding-block: 4.5rem 3rem;
    }

    .public-build__ledger {
      padding-block: 4rem 3rem;
    }

    .public-build__ledger header {
      grid-template-columns: 1fr;
      margin-bottom: 2.5rem;
    }

    .public-build__ledger nav a {
      min-height: 6rem;
      grid-template-columns: 4.5rem minmax(0, 1fr) 1rem;
      gap: 0.65rem;
      padding-block: 0.8rem;
    }

    .public-build__row-detail {
      grid-column: 2;
    }

    .public-build__ledger strong {
      grid-row: 1;
    }

    .public-build__ledger i {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
  }

  @media (max-width: 22rem) {
    .public-build__ledger nav a {
      grid-template-columns: 4rem minmax(0, 1fr) 1rem;
    }
  }
</style>
