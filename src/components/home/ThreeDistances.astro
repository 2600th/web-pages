---
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'work'>[];
}

const { work } = Astro.props;
type FullCaseEntry = CollectionEntry<'work'> & {
  data: Exclude<CollectionEntry<'work'>['data'], { recordType: 'evidence-note' }>;
};
const projects = work
  .filter((entry): entry is FullCaseEntry => entry.data.recordType !== 'evidence-note')
  .sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);
const distances = [
  { id: 'out', label: 'OUT', detail: 'Thesis' },
  { id: 'near', label: 'NEAR', detail: 'Experience' },
  { id: 'inside', label: 'INSIDE', detail: 'Decisions' },
] as const;
---

<section class="work-field" id="selected-work" aria-labelledby="selected-work-title" data-three-distances>
  <header class="work-field__header">
    <div>
      <p>Selected work · three viewing distances</p>
      <h2 id="selected-work-title">Proof changes with proximity.</h2>
    </div>
    <p class="work-field__intro">
      Start with what exists. Move closer to the experience. Go inside for decisions, constraints, and evidence.
    </p>
  </header>

  <nav class="practice-index" aria-label="Compound practice pillars">
    <a href="/?work=blocks-inco-ai&distance=out#selected-work"><strong>Production AI</strong><span>Blocks + INCO-AI</span></a>
    <a href="/?work=blocks-inco-ai&distance=inside#selected-work"><strong>Design Technology</strong><span>Workflow, catalog, visualization</span></a>
    <a href="/work/ira-vr/"><strong>Immersive Systems</strong><span>XR, simulation, robotics</span></a>
    <a href="/?work=kinema&distance=out#selected-work"><strong>Browser-native Lab</strong><span>Games, graphics, interaction</span></a>
  </nav>

  <nav class="project-index" aria-label="Selected projects">
    {projects.map((project, index) => (
      <a
        href={`/?work=${project.data.slug}&distance=out#selected-work`}
        data-work-link={project.data.slug}
        aria-current={index === 0 ? 'true' : undefined}
      >
        <span>{String(index + 1).padStart(2, '0')}</span>
        <strong>{project.data.title}</strong>
        <small>{project.data.disciplines[0]}</small>
      </a>
    ))}
  </nav>

  <div class="project-stage">
    {projects.map((project, projectIndex) => (
      <article class="project" data-work-project={project.data.slug} hidden={projectIndex !== 0}>
        <header class="project__header">
          <div>
            <p>{project.data.yearStart} · {project.data.status}</p>
            <h3>{project.data.title}</h3>
          </div>
          <div class="distance-control" role="group" aria-label={`Viewing distance for ${project.data.title}`}>
            {distances.map((distance, index) => (
              <button type="button" data-distance={distance.id} aria-pressed={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>
                <strong>{distance.label}</strong>
                <span>{distance.detail}</span>
              </button>
            ))}
          </div>
        </header>

        <section class="distance-panel" data-distance-panel="out" aria-labelledby={`${project.data.slug}-out-title`}>
          <figure style={`--media-ratio: ${project.data.out.media.width} / ${project.data.out.media.height};`}>
            <img src={project.data.out.media.src} alt={project.data.out.media.alt} width={project.data.out.media.width} height={project.data.out.media.height} loading="lazy" />
            <figcaption>OUT · What exists and why it matters</figcaption>
          </figure>
          <div class="distance-panel__copy">
            <p class="distance-panel__marker">OUT / 01</p>
            <h4 id={`${project.data.slug}-out-title`}>{project.data.out.thesis}</h4>
            <dl>
              <div><dt>For</dt><dd>{project.data.out.audience}</dd></div>
              <div><dt>Public result</dt><dd>{project.data.out.outcome}</dd></div>
            </dl>
            <a href={`/work/${project.data.slug}/`} data-event="work_open" data-event-context="three_distances" data-event-slug={project.data.slug}>Open the case study <span aria-hidden="true">↗</span></a>
          </div>
        </section>

        <section class="distance-panel" data-distance-panel="near" aria-labelledby={`${project.data.slug}-near-title`}>
          <figure style={`--media-ratio: ${project.data.near.media.width} / ${project.data.near.media.height};`}>
            <img src={project.data.near.media.src} alt={project.data.near.media.alt} width={project.data.near.media.width} height={project.data.near.media.height} loading="lazy" />
            <figcaption>NEAR · Product experience and system boundary</figcaption>
          </figure>
          <div class="distance-panel__copy">
            <p class="distance-panel__marker">NEAR / 02</p>
            <h4 id={`${project.data.slug}-near-title`}>{project.data.near.experience}</h4>
            <dl>
              <div><dt>Contribution</dt><dd>{project.data.near.contribution}</dd></div>
              <div><dt>System</dt><dd>{project.data.near.system}</dd></div>
            </dl>
            <a href={`/work/${project.data.slug}/`}>Open the case study <span aria-hidden="true">↗</span></a>
          </div>
        </section>

        <section class="distance-panel" data-distance-panel="inside" aria-labelledby={`${project.data.slug}-inside-title`}>
          <figure style={`--media-ratio: ${project.data.inside.media.width} / ${project.data.inside.media.height};`}>
            <img src={project.data.inside.media.src} alt={project.data.inside.media.alt} width={project.data.inside.media.width} height={project.data.inside.media.height} loading="lazy" />
            <figcaption>INSIDE · Decisions, constraints, evidence</figcaption>
          </figure>
          <div class="distance-panel__copy">
            <p class="distance-panel__marker">INSIDE / 03</p>
            <h4 id={`${project.data.slug}-inside-title`}>The decisions that shaped {project.data.title}.</h4>
            <ol class="decision-list">
              {project.data.inside.decisions.map((decision) => <li>{decision}</li>)}
            </ol>
            <a href={`/work/${project.data.slug}/`}>Read decisions and evidence <span aria-hidden="true">↗</span></a>
          </div>
        </section>
      </article>
    ))}
  </div>
</section>

<script>
  import { initThreeDistances } from '../../scripts/distance-state';
  initThreeDistances();
  document.addEventListener('astro:after-swap', initThreeDistances);
</script>

<style>
  .work-field {
    --work-surface: #0b0b0b;
    --work-text: #faf9f5;
    --work-muted: #a7a6a0;
    padding: clamp(5rem, 10vw, 9rem) var(--page-gutter) clamp(4rem, 9vw, 8rem);
    background: var(--work-surface);
    color: var(--work-text);
  }

  .work-field__header {
    display: grid;
    grid-template-columns: 2fr 0.75fr;
    gap: 2rem;
    align-items: end;
  }

  .work-field__header > div > p,
  .project__header p {
    margin-bottom: 1rem;
    color: #7692ff;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .work-field__header h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 7vw, 6rem);
  }

  .work-field__intro {
    max-width: 34ch;
    margin: 0 0 0.6rem;
    color: var(--work-muted);
    font-size: 0.92rem;
  }

  .practice-index {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(3rem, 6vw, 5.5rem);
    border-block: 1px solid rgba(250, 249, 245, 0.22);
  }

  .practice-index a {
    display: grid;
    min-height: 6.5rem;
    padding: 1rem;
    align-content: space-between;
    border-right: 1px solid rgba(250, 249, 245, 0.22);
    color: var(--work-text);
    text-decoration: none;
  }

  .practice-index a:last-child { border-right: 0; }
  .practice-index strong { font-size: clamp(1rem, 1.5vw, 1.35rem); }
  .practice-index span { color: var(--work-muted); font-size: 0.68rem; }
  .practice-index a:hover { background: var(--cobalt); }
  .practice-index a:hover span { color: white; }

  .project-index {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 1rem;
    border-top: 1px solid rgba(250, 249, 245, 0.22);
    border-bottom: 1px solid rgba(250, 249, 245, 0.22);
  }

  .project-index a {
    display: grid;
    min-height: 7.4rem;
    padding: 1rem;
    grid-template-columns: auto 1fr;
    grid-template-rows: 1fr auto;
    gap: 0.2rem 0.8rem;
    border-right: 1px solid rgba(250, 249, 245, 0.22);
    color: var(--work-muted);
    text-decoration: none;
    transition: background-color 220ms var(--ease-out), color 220ms var(--ease-out);
  }

  .project-index a:last-child { border-right: 0; }
  .project-index a > span { color: #7692ff; font-size: 0.68rem; }
  .project-index strong { align-self: start; font-size: 1rem; }
  .project-index small { grid-column: 2; font-size: 0.68rem; }

  .project-index a:hover,
  .project-index a[aria-current='true'] {
    background: #1547ff;
    color: white;
  }

  .project-index a[aria-current='true'] > span { color: white; }

  .project-stage { padding-top: clamp(3rem, 6vw, 5rem); }
  .project[hidden] { display: none; }

  .project__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .project__header h3 {
    max-width: none;
    margin: 0;
    font-size: clamp(3rem, 7vw, 6rem);
  }

  .distance-control {
    display: flex;
    border-bottom: 1px solid rgba(250, 249, 245, 0.3);
  }

  .distance-control button {
    min-width: 7rem;
    min-height: 4rem;
    padding: 0.65rem 0.8rem;
    border: 0;
    border-bottom: 0.2rem solid transparent;
    background: transparent;
    color: var(--work-muted);
    text-align: left;
    cursor: pointer;
  }

  .distance-control button strong,
  .distance-control button span { display: block; }
  .distance-control button strong { font-size: 0.78rem; }
  .distance-control button span { margin-top: 0.25rem; font-size: 0.64rem; }

  .distance-control button[aria-pressed='true'] {
    border-bottom-color: #7692ff;
    color: white;
  }

  .distance-panel {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(18rem, 0.72fr);
    gap: 0;
    align-items: stretch;
    padding-bottom: 4rem;
  }

  [data-enhanced='true'] .distance-panel[hidden] { display: none; }

  .distance-panel figure {
    position: relative;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    aspect-ratio: var(--media-ratio);
  }

  .distance-panel img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #171717;
  }

  .distance-panel figcaption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    margin: 0;
    padding-top: 3rem;
    background: linear-gradient(180deg, transparent, rgba(9, 9, 9, 0.76));
    color: #d2d1cb;
    font-size: 0.67rem;
  }

  .distance-panel__copy {
    display: flex;
    padding: clamp(1.5rem, 3vw, 2.8rem);
    flex-direction: column;
    justify-content: center;
    background: #11110f;
  }

  .distance-panel__marker {
    margin-bottom: 1rem;
    color: #7692ff;
    font-size: 0.7rem;
    font-weight: 760;
  }

  .distance-panel h4 {
    margin: 0 0 2.25rem;
    font-size: clamp(1.45rem, 2.6vw, 2.45rem);
    font-weight: 620;
    letter-spacing: -0.025em;
    line-height: 1.07;
  }

  .distance-panel dl { margin: 0 0 2.25rem; }

  .distance-panel dl > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-top: 1px solid rgba(250, 249, 245, 0.2);
  }

  .distance-panel dt {
    color: var(--work-muted);
    font-size: 0.68rem;
  }

  .distance-panel dd {
    margin: 0;
    font-size: 0.82rem;
  }

  .distance-panel__copy > a {
    color: white;
    font-size: 0.82rem;
    font-weight: 720;
  }

  .decision-list {
    margin: 0 0 2.25rem;
    padding: 0;
    list-style: none;
    counter-reset: decisions;
  }

  .decision-list li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.6rem;
    padding: 0.8rem 0;
    border-top: 1px solid rgba(250, 249, 245, 0.2);
    color: var(--work-muted);
    font-size: 0.8rem;
    counter-increment: decisions;
  }

  .decision-list li::before {
    color: #7692ff;
    content: counter(decisions, decimal-leading-zero);
  }

  @media (max-width: 62rem) {
    .practice-index { grid-template-columns: repeat(2, 1fr); }
    .practice-index a:nth-child(-n + 2) { border-bottom: 1px solid rgba(250, 249, 245, 0.22); }
    .practice-index a:nth-child(2) { border-right: 0; }

    .project-index { grid-template-columns: repeat(2, 1fr); }
    .project-index a:nth-child(2) { border-right: 0; }
    .project-index a:nth-child(-n + 2) { border-bottom: 1px solid rgba(250, 249, 245, 0.22); }

    .project__header {
      align-items: start;
      flex-direction: column;
    }

    .distance-panel { grid-template-columns: 1fr; }
    .distance-panel__copy { max-width: 42rem; }
  }

  @media (max-width: 42rem) {
    .work-field__header { grid-template-columns: 1fr; }
    .work-field__intro { margin-top: 0.5rem; }

    .practice-index { display: flex; overflow-x: auto; }
    .practice-index a { min-width: 13rem; border-bottom: 0 !important; }

    .project-index {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    .project-index a {
      min-width: 13.5rem;
      scroll-snap-align: start;
      border-bottom: 0 !important;
    }

    .project__header h3 { font-size: 3.2rem; }

    .distance-control {
      width: 100%;
      overflow-x: auto;
    }

    .distance-control button {
      min-width: 33.333%;
      min-height: 4.4rem;
    }

  }

</style>
