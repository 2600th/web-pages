---
import { TIMELINE } from '../../data/site';
---

<section class="motion-study" aria-labelledby="motion-study-title" data-motion-study>
  <header class="motion-study__header">
    <p>Motion Study · 2011—Now</p>
    <h2 id="motion-study-title">Fifteen years. One recurring move.</h2>
    <p class="motion-study__intro">Take an unfamiliar medium, find its product shape, and make the difficult parts survive contact with real use.</p>
  </header>

  <div class="motion-study__stage" aria-live="polite">
    {TIMELINE.map((entry, index) => (
      <article
        class:list={['motion-frame', entry.image && 'motion-frame--image']}
        data-motion-frame
        data-year={entry.year}
        data-label={entry.label}
        hidden={index !== 0}
        aria-hidden={index !== 0 ? 'true' : 'false'}
        style={entry.image ? `--frame-image: url('${entry.image}')` : undefined}
      >
        <p class="motion-frame__year">{entry.year}</p>
        <div class="motion-frame__copy">
          <h3>{entry.label}</h3>
          <p>{entry.summary}</p>
          {entry.href && <a href={entry.href}>Open evidence <span aria-hidden="true">↗</span></a>}
        </div>
      </article>
    ))}
  </div>

  <div class="motion-study__controls">
    <button type="button" data-motion-previous aria-label="Previous career frame" disabled>←</button>
    <label>
      <span class="sr-only">Career timeline</span>
      <input
        type="range"
        min="0"
        max={TIMELINE.length - 1}
        value="0"
        step="1"
        data-motion-range
        aria-valuetext={`${TIMELINE[0].year}: ${TIMELINE[0].label}`}
      />
    </label>
    <button type="button" data-motion-next aria-label="Next career frame">→</button>
  </div>

  <ol class="motion-study__list">
    {TIMELINE.map((entry) => (
      <li>
        <time>{entry.year}</time>
        <div><strong>{entry.label}</strong><span>{entry.summary}</span></div>
      </li>
    ))}
  </ol>
</section>

<script>
  import { initMotionStudy } from '../../scripts/motion-study';
  initMotionStudy();
  document.addEventListener('astro:after-swap', initMotionStudy);
</script>

<style>
  .motion-study {
    padding: clamp(5rem, 11vw, 10rem) var(--page-gutter);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .motion-study__header {
    display: grid;
    grid-template-columns: 0.55fr 1.7fr 0.8fr;
    gap: clamp(1.5rem, 4vw, 4.5rem);
    align-items: end;
  }

  .motion-study__header > p:first-child {
    align-self: start;
    color: var(--cobalt);
    font-size: 0.75rem;
    font-weight: 720;
  }

  .motion-study__header h2 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(3rem, 6.5vw, 6rem);
  }

  .motion-study__intro {
    max-width: 31ch;
    margin: 0 0 0.45rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .motion-study__stage {
    margin-top: clamp(3.5rem, 7vw, 6.5rem);
  }

  .motion-frame {
    position: relative;
    display: grid;
    min-height: clamp(23rem, 47vw, 39rem);
    padding: clamp(1.25rem, 3vw, 2.5rem);
    grid-template-columns: 1.35fr 0.65fr;
    gap: 2rem;
    align-items: end;
    overflow: hidden;
    background: var(--text);
    color: var(--surface);
    isolation: isolate;
  }

  .motion-frame[hidden] { display: none; }

  .motion-frame::before {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(100deg, transparent 0 55%, color-mix(in srgb, var(--cobalt) 60%, transparent) 55%),
      linear-gradient(165deg, transparent 0 55%, color-mix(in srgb, var(--surface) 11%, transparent) 55%);
    content: '';
  }

  .motion-frame--image::before {
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ink) 84%, transparent) 0 42%, color-mix(in srgb, var(--ink) 16%, transparent) 76%),
      var(--frame-image) center / cover;
    filter: saturate(0.92) contrast(1.04);
  }

  .motion-frame__year {
    margin: 0;
    font-size: clamp(7rem, 24vw, 21rem);
    font-stretch: 82%;
    font-weight: 820;
    letter-spacing: -0.04em;
    line-height: 0.7;
  }

  .motion-frame__copy {
    max-width: 30rem;
    padding-bottom: 0.3rem;
  }

  .motion-frame__copy h3 {
    margin-bottom: 1rem;
    font-size: clamp(1.65rem, 3vw, 3rem);
    line-height: 0.98;
  }

  .motion-frame__copy p { font-size: 0.9rem; }

  .motion-frame__copy a {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .motion-study__controls {
    display: grid;
    grid-template-columns: 3.5rem 1fr 3.5rem;
    gap: 1rem;
    align-items: center;
    margin-top: 1.2rem;
  }

  .motion-study__controls button {
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .motion-study__controls button:disabled {
    color: var(--fog);
    cursor: not-allowed;
  }

  .motion-study__controls input {
    width: 100%;
    accent-color: var(--cobalt);
    cursor: ew-resize;
  }

  .motion-study__list {
    display: grid;
    margin: clamp(4rem, 8vw, 7rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .motion-study__list li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 2rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--line);
  }

  .motion-study__list time {
    color: var(--cobalt);
    font-size: 0.76rem;
    font-weight: 720;
  }

  .motion-study__list div {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 2rem;
  }

  .motion-study__list strong { font-size: 0.88rem; }
  .motion-study__list span { color: var(--text-muted); font-size: 0.8rem; }

  @media (max-width: 56rem) {
    .motion-study__header { grid-template-columns: 1fr; }

    .motion-frame {
      grid-template-columns: 1fr;
      align-content: end;
    }

    .motion-frame__year { font-size: clamp(7rem, 30vw, 14rem); }
    .motion-frame__copy { padding-top: 3rem; }

    .motion-study__list div { grid-template-columns: 1fr; gap: 0.3rem; }
  }

  @media (max-width: 38rem) {
    .motion-frame { min-height: 32rem; }

    .motion-study__list li {
      grid-template-columns: 3.5rem 1fr;
      gap: 1rem;
    }
  }
</style>
