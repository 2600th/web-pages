---
import type { WorkEntry } from '../../content/schemas';

interface Props {
  sources: WorkEntry['sources'];
}

const { sources } = Astro.props;
const sourceTypeLabels: Record<WorkEntry['sources'][number]['type'], string> = {
  repository: 'Code',
  'live-demo': 'Try it',
  'authored-post': 'My write-up',
  'employer-post': 'Company post',
  'shared-archive': 'Project media',
  press: 'Press coverage',
  'official-source': 'Official source',
  'company-profile': 'Company profile',
  'app-directory': 'App listing',
};
---

<section class="evidence-sources" data-project-sources aria-labelledby="project-sources-title">
  <div class="evidence-sources__heading">
    <p class="evidence-sources__label">Go deeper</p>
    <h2 id="project-sources-title">Sources and links</h2>
  </div>
  <ul>
    {sources.map((source, index) => (
      <li>
        <a href={source.url} target="_blank" rel="noreferrer">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{source.label}</strong>
          <small>{sourceTypeLabels[source.type]}</small>
          <span aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .evidence-sources {
    margin-top: clamp(5rem, 10vw, 9rem);
    padding: clamp(2rem, 5vw, 4.5rem) 0;
    border-top: 2px solid var(--signal);
    color: var(--text);
  }

  .evidence-sources__heading { display: grid; gap: 0.4rem; margin-bottom: 2rem; }
  .evidence-sources__label { margin: 0; color: var(--signal); font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }

  .evidence-sources h2 {
    max-width: none;
  }

  .evidence-sources ul {
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .evidence-sources li {
    border-bottom: 1px solid var(--line);
  }

  .evidence-sources a {
    display: grid;
    grid-template-columns: 2rem minmax(12rem, 1fr) auto auto;
    gap: 1rem;
    align-items: center;
    padding: 1.2rem 0;
    text-decoration: none;
  }

  .evidence-sources small,
  .evidence-sources a > span:first-child {
    opacity: 0.92;
    text-transform: uppercase;
  }

  @media (max-width: 40rem) {
    .evidence-sources a {
      grid-template-columns: 2rem 1fr auto;
    }

    .evidence-sources small {
      grid-column: 2;
    }
  }
</style>
