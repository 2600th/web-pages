---
import type { WorkEntry } from '../../content/schemas';

interface Props {
  sources: WorkEntry['sources'];
}

const { sources } = Astro.props;
const sourceTypeLabels: Record<WorkEntry['sources'][number]['type'], string> = {
  repository: 'Code',
  'live-demo': 'Try it',
  'authored-post': 'My write-up',
  'employer-post': 'Company post',
  'shared-archive': 'Project media',
  press: 'Press coverage',
  'official-source': 'Official source',
  'company-profile': 'Company profile',
  'app-directory': 'App listing',
};
---

<section class="evidence-sources" data-project-sources aria-labelledby="project-sources-title">
  <div class="evidence-sources__heading">
    <p class="evidence-sources__label">Go deeper</p>
    <h2 id="project-sources-title">Sources and links</h2>
  </div>
  <ul>
    {sources.map((source, index) => (
      <li>
        <a href={source.url} target="_blank" rel="noreferrer">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{source.label}{source.description && <span class="evidence-sources__description">{source.description}</span>}</strong>
          <small>{source.contextLabel ?? sourceTypeLabels[source.type]}</small>
          <span aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>
</section>
