---
import type { CollectionEntry } from 'astro:content';
import ResponsiveImage from '../shared/ResponsiveImage.astro';

interface Props { work: CollectionEntry<'work'>[]; uniform?: boolean; }
const { work, uniform = false } = Astro.props;
const galleryRole = (slug: string) => slug === 'blocks' ? 'lead' : ['designesto', 'ira-vr'].includes(slug) ? 'support' : 'more';
---

<ol class="work-gallery" data-work-gallery data-gallery-layout={uniform ? 'uniform' : 'featured'}>
  {work.map((entry, index) => (
    <li class={`work-gallery__item work-gallery__item--${galleryRole(entry.data.slug)}`} data-work-item data-gallery-role={galleryRole(entry.data.slug)} data-work-year={entry.data.yearStart} data-work-career-order={entry.data.careerOrder} data-work-domains={entry.data.domains.join(' ')}>
      <a class="work-gallery__link" href={`/work/${entry.data.slug}/`} aria-labelledby={`work-title-${entry.data.slug}`} data-sfx="tick" data-cursor-text="Open">
        <span class="work-gallery__image">
          {entry.data.heroMedia ? (
            <ResponsiveImage src={entry.data.heroMedia.src} avif={entry.data.heroMedia.avif} alt={entry.data.heroMedia.alt} width={entry.data.heroMedia.width} height={entry.data.heroMedia.height} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} sizes="(max-width: 46rem) calc(100vw - 2rem), (max-width: 64rem) 50vw, 34vw" />
          ) : <span class="work-gallery__type" aria-hidden="true">{entry.data.yearStart}</span>}
        </span>
        <span class="work-gallery__caption">
          <span class="work-list__meta">{entry.data.metadataLabel ?? `${entry.data.yearStart} · ${entry.data.status}`}</span>
          <span class="work-gallery__title"><strong id={`work-title-${entry.data.slug}`}>{entry.data.title}</strong><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></span>
          <span class="work-gallery__summary">{entry.data.summary}</span>
          <span class="work-list__disciplines">{entry.data.disciplines.slice(0, 3).join(' · ')}</span>
        </span>
      </a>
    </li>
  ))}
</ol>
