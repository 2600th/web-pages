---
import type { CollectionEntry } from 'astro:content';
import ResponsiveImage from '../shared/ResponsiveImage.astro';

interface Props { work: CollectionEntry<'work'>[]; uniform?: boolean; }
const { work, uniform = false } = Astro.props;
const galleryRole = (slug: string) => slug === 'blocks' ? 'lead' : ['designesto', 'ira-vr'].includes(slug) ? 'support' : 'more';
---

<ol class="work-gallery" data-work-gallery data-gallery-layout={uniform ? 'uniform' : 'featured'}>
  {work.map((entry, index) => (
    <li class={`work-gallery__item work-gallery__item--${galleryRole(entry.data.slug)}`} data-work-item data-gallery-role={galleryRole(entry.data.slug)} data-work-year={entry.data.yearStart} data-work-career-order={entry.data.careerOrder} data-work-domains={entry.data.domains.join(' ')}>
      <a class="work-gallery__link" href={`/work/${entry.data.slug}/`} aria-labelledby={`work-title-${entry.data.slug}`}>
        <span class="work-gallery__image">
          {entry.data.heroMedia ? (
            <ResponsiveImage src={entry.data.heroMedia.src} avif={entry.data.heroMedia.avif} alt={entry.data.heroMedia.alt} width={entry.data.heroMedia.width} height={entry.data.heroMedia.height} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} sizes="(max-width: 46rem) calc(100vw - 2.5rem), (max-width: 70rem) 50vw, 40vw" />
          ) : <span class="work-gallery__type" aria-hidden="true">{entry.data.yearStart}</span>}
        </span>
        <span class="work-gallery__caption">
          <span class="work-gallery__title"><strong id={`work-title-${entry.data.slug}`}>{entry.data.title}</strong><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></span>
          <span class="work-list__meta">{entry.data.metadataLabel ?? `${entry.data.yearStart} · ${entry.data.status}`}</span>
          <span class="work-gallery__summary">{entry.data.summary}</span>
          <span class="work-list__disciplines">{entry.data.disciplines.slice(0, 3).join(' · ')}</span>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .work-gallery { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 3.5rem) clamp(1.25rem, 3vw, 2rem); margin: 0; padding: 0; list-style: none; }
  .work-gallery__item { grid-column: span 3; min-width: 0; }
  .work-gallery__item--lead { grid-column: span 4; grid-row: span 2; order: 1; }
  .work-gallery__item--support { grid-column: span 2; order: 2; }
  .work-gallery__item--more { order: 3; }
  .work-gallery__item[hidden] { display: none; }
  .work-gallery[data-gallery-layout='uniform'] .work-gallery__item { grid-column: span 3; grid-row: auto; order: initial; }
  .work-gallery__link { display: block; color: inherit; text-decoration: none; }
  .work-gallery__image { display: grid; overflow: hidden; width: 100%; aspect-ratio: 16 / 9; place-items: center; background: var(--surface-raised); }
  .work-gallery__item--lead .work-gallery__image { aspect-ratio: 16 / 10; }
  .work-gallery__image :global(picture) { width: 100%; height: 100%; }
  .work-gallery__image :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; filter: saturate(0.8); transition: filter 350ms var(--ease-out), transform 500ms var(--ease-out); }
  .work-gallery__item--lead .work-gallery__image :global(img) { object-fit: cover; }
  .work-gallery__type { display: grid; width: 100%; height: 100%; padding: 1rem; place-items: end start; color: var(--surface); background: var(--text); font-size: clamp(2.5rem, 7vw, 6rem); font-weight: 780; }
  .work-gallery__caption { display: grid; gap: 0.55rem; padding-top: 1rem; }
  .work-gallery__title { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .work-gallery__title strong { font-size: clamp(1.65rem, 3vw, 2.5rem); font-stretch: var(--heading-stretch); letter-spacing: var(--heading-tracking); line-height: 1.15; }
  .work-gallery__title svg { flex: 0 0 auto; width: 1.25rem; color: var(--signal); fill: none; stroke: currentColor; stroke-width: 1.5; }
  .work-list__meta, .work-list__disciplines { color: var(--text-muted); font-size: var(--type-label, 0.72rem); font-weight: 680; letter-spacing: 0.03em; text-transform: uppercase; }
  .work-gallery__summary { max-width: 58ch; color: var(--text-muted); line-height: 1.6; }
  .work-gallery__link:hover .work-gallery__image :global(img), .work-gallery__link:focus-visible .work-gallery__image :global(img) { filter: saturate(1); transform: scale(1.025); }
  .work-gallery__link:hover .work-gallery__title strong { color: var(--signal); }
  @media (max-width: 46rem) {
    .work-gallery, .work-gallery[data-gallery-layout='uniform'] { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .work-gallery .work-gallery__item { grid-column: 1; grid-row: auto; order: initial; width: 100%; }
    .work-gallery__item--lead .work-gallery__image { aspect-ratio: 16 / 9; }
    .work-gallery__title strong { font-size: 1.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-gallery__image :global(img) { transition: none; }
    .work-gallery__link:hover .work-gallery__image :global(img), .work-gallery__link:focus-visible .work-gallery__image :global(img) { transform: none; }
  }
</style>
