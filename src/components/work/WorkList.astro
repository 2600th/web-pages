---
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'work'>[];
}

const { work } = Astro.props;
---

<ol class="work-list">
  {work.map((entry, index) => (
    <li data-work-item data-work-year={entry.data.yearStart} data-work-career-order={entry.data.careerOrder} data-work-domains={entry.data.domains.join(' ')}>
      <a href={`/work/${entry.data.slug}/`}>
        <span class="work-list__number">{String(index + 1).padStart(2, '0')}</span>
        {entry.data.heroMedia ? (
          <span class="work-list__image">
            <img
              src={entry.data.heroMedia.src}
              alt={entry.data.heroMedia.alt}
              width={entry.data.heroMedia.width}
              height={entry.data.heroMedia.height}
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </span>
        ) : (
          <span class="work-list__image work-list__image--type" aria-hidden="true">
            <span>{entry.data.yearStart}</span>
          </span>
        )}
        <span class="work-list__body">
          <span class="work-list__meta">{entry.data.yearStart} · {entry.data.status}</span>
          <strong>{entry.data.title}</strong>
          <span>{entry.data.summary}</span>
          <span class="work-list__disciplines">{entry.data.disciplines.slice(0, 3).join(' · ')}</span>
        </span>
        <span class="work-list__arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ol>

<style>
  .work-list {
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .work-list li {
    border-bottom: 1px solid var(--line);
  }

  .work-list a {
    display: grid;
    grid-template-columns: 3rem minmax(12rem, 0.85fr) minmax(18rem, 1.3fr) auto;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: center;
    padding: clamp(1rem, 2.5vw, 2.2rem) 0;
    text-decoration: none;
  }

  .work-list__number,
  .work-list__meta,
  .work-list__disciplines {
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 680;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .work-list__image {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--surface-raised);
  }

  .work-list__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.76);
    transform: scale(1.01);
    transition: filter 420ms var(--ease-out), transform 720ms var(--ease-out);
  }

  .work-list__image--type {
    display: grid;
    place-items: end start;
    padding: 0.8rem;
    background: var(--text);
    color: var(--surface);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 780;
  }

  .work-list__body {
    display: grid;
    gap: 0.45rem;
  }

  .work-list__body strong {
    font-size: clamp(1.7rem, 3.2vw, 3.4rem);
    font-stretch: 92%;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .work-list__body > span:not(.work-list__meta, .work-list__disciplines) {
    max-width: 65ch;
    color: var(--text-muted);
  }

  .work-list__arrow {
    color: var(--signal);
    font-size: 1.5rem;
    transition: transform 240ms var(--ease-out);
  }

  .work-list a:hover .work-list__image img {
    filter: saturate(1.04);
    transform: scale(1.045);
  }

  .work-list a:hover .work-list__arrow {
    transform: translate(0.2rem, -0.2rem);
  }

  @media (max-width: 52rem) {
    .work-list a {
      grid-template-columns: 2rem 1fr auto;
    }

    .work-list__image {
      grid-column: 2 / -1;
      grid-row: 1;
    }

    .work-list__number {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
    }

    .work-list__body {
      grid-column: 2 / -1;
    }

    .work-list__arrow {
      display: none;
    }
  }
</style>
