---
import ResponsiveImage from '../shared/ResponsiveImage.astro';
interface Props {
  media: { src: string; avif?: string; alt: string; width: number; height: number; mp4?: string; webm?: string };
  label: string;
  priority?: boolean;
}

const { media, label, priority = false } = Astro.props;
---

<figure class="project-media" data-evidence-media data-media-label={label}>
  {media.mp4 ? (
    <video controls muted loop playsinline preload="none" poster={media.src} width={media.width} height={media.height} aria-label={media.alt} data-evidence-video>
      {media.webm && <source src={media.webm} type="video/webm" />}
      <source src={media.mp4} type="video/mp4" />
    </video>
  ) : (
    <ResponsiveImage src={media.src} avif={media.avif} alt={media.alt} width={media.width} height={media.height} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
  )}
  <figcaption>
    <span>{label}</span>
    {media.mp4 && <button type="button" data-evidence-video-toggle aria-label={`Play ${label} clip`} aria-pressed="false" hidden>Play</button>}
  </figcaption>
</figure>

{media.mp4 && (
  <script>
    import { initEvidenceMedia } from '../../scripts/evidence-media';
    initEvidenceMedia();
    document.addEventListener('astro:after-swap', initEvidenceMedia);
  </script>
)}
