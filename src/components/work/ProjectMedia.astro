---
interface Props {
  media: { src: string; alt: string; width: number; height: number; mp4?: string; webm?: string };
  label: string;
  priority?: boolean;
}

const { media, label, priority = false } = Astro.props;
---

<figure class="project-media" data-evidence-media data-media-label={label}>
  {media.mp4 ? (
    <video controls muted loop playsinline preload="none" poster={media.src} width={media.width} height={media.height} aria-label={media.alt} data-evidence-video>
      {media.webm && <source src={media.webm} type="video/webm" />}
      <source src={media.mp4} type="video/mp4" />
    </video>
  ) : (
    <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
  )}
  <figcaption>
    <span>{label}</span>
    {media.mp4 && <button type="button" data-evidence-video-toggle aria-label={`Play ${label} clip`}>Play</button>}
  </figcaption>
</figure>

{media.mp4 && (
  <script>
    import { initEvidenceMedia } from '../../scripts/evidence-media';
    initEvidenceMedia();
    document.addEventListener('astro:after-swap', initEvidenceMedia);
  </script>
)}

<style>
  .project-media {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--ink);
  }

  .project-media img,
  .project-media video {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .project-media figcaption {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.85rem;
    border-top: 1px solid var(--signal);
    background: var(--inverse-surface);
    color: var(--inverse-text);
    font-size: 0.72rem;
    font-weight: 720;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project-media figcaption span { display: block; }

  .project-media figcaption button {
    min-width: 3.25rem;
    min-height: 2.75rem;
    margin: -0.25rem 0;
    border: 1px solid var(--signal);
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }
</style>
