---
import PathCrumb from './PathCrumb.astro';
import Trace from './Trace.astro';

type Crumb = { label: string; href?: string };
interface Props {
  eyebrow: [string, string];
  path: Crumb[];
  lede?: string;
  readout?: [string, string][];
  wave?: 'sine' | 'square' | 'saw' | 'noise' | 'tones';
  long?: boolean;
  /** Index pages whose content is the list below: a shorter opening so the first item shows. */
  compact?: boolean;
}
const { eyebrow, path, lede, readout = [], wave = 'sine', long = false, compact = false } = Astro.props;

---

<header class:list={['pg-open route-opening', { 'pg-open--long': long, 'pg-open--compact': compact }]} data-route-opening>
  <div class="pg-open__copy">
    <PathCrumb items={path} />
    <p class="sg-eyebrow"><span>{eyebrow[0]}</span> {eyebrow[1]}</p>
    <slot name="title" />
    {lede && <p class="pg-lede">{lede}</p>}
    <slot />
  </div>
  {(readout.length > 0 || Astro.slots.has('aside')) && (
    <div class="pg-open__aside">
      {readout.length > 0 && <dl class="pg-readout">{readout.map(([label, value]) => <div><dt>{label}</dt><dd set:html={value} /></div>)}</dl>}
      <slot name="aside" />
    </div>
  )}
  <Trace wave={wave} />
</header>
