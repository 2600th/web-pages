---
interface Props { variant: 'home' | 'page'; status?: string }
const { variant, status } = Astro.props;
const path = Astro.url.pathname;
// The homepage navigates its own story; every other page navigates the site.
const items = variant === 'home'
  ? [['#work', 'Work'], ['#log', 'Log'], ['#lab', 'Lab'], ['#notes', 'Notes'], ['/about/', 'About'], ['#contact', 'Contact']]
  : [['/work/', 'Work'], ['/lab/', 'Lab'], ['/notes/', 'Notes'], ['/about/', 'About'], ['#contact', 'Contact']];
const current = (href: string) => variant === 'page' && href.startsWith('/') && path.startsWith(href) ? 'page' : undefined;
---

<header class="sg-top" data-header>
  <a class="sg-mark" href={variant === 'home' ? '#top' : '/'} aria-label={variant === 'home' ? '2600th, back to top' : '2600th, Pranshul Chandhok, home'}>
    <svg class="sg-mark__wave" viewBox="0 0 28 16" aria-hidden="true"><path d="M1 8c2.5-6 4.5-6 6.5 0s4 6 6.5 0 4-6 6.5 0 4 6 6.5 0" /></svg>
    <span>2600</span><sup>th</sup>
  </a>
  <button type="button" class="sg-menu" data-menu aria-expanded="false" aria-controls="site-menu">Menu</button>
  <!-- On wide screens the panel dissolves into the header row; on phones the menu button opens it. -->
  <div class="sg-panel" id="site-menu" data-menu-panel>
    <nav class="sg-nav" id="primary-nav" aria-label="Primary navigation">
      {items.map(([href, label]) => <a href={href} aria-current={current(href)} data-sfx="tick">{label}</a>)}
    </nav>
    <div class="sg-controls">
      <p class="sg-status" data-status data-state={variant === 'page' ? 'locked' : undefined}><i></i><span data-status-label>{variant === 'page' ? (status ?? 'Locked · 2600 Hz') : 'Line idle'}</span></p>
      <button type="button" class="sg-chip" data-sound-toggle aria-pressed="false">
        <span class="sg-chip__bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="sg-chip__label" data-sound-label>Sound off</span>
      </button>
      <button type="button" class="sg-chip" data-motion-toggle aria-pressed="true">
        <span class="sg-chip__dot" aria-hidden="true"></span><span class="sg-chip__label" data-motion-label>Motion on</span>
      </button>
    </div>
  </div>
</header>
