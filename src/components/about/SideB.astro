---
/**
 * Side B: a Sony Walkman and a pile of tapes. Pick a tape and it plays: rock tapes stream
 * from their official YouTube uploads in the player on the J-card (YouTube loads on the first
 * play, never before); the last tape plays the site's own tones. With motion on the Walkman is
 * a 3D scene that follows the music; otherwise a still of it. The full tracklists, with links,
 * are below for everyone.
 */
import { TAPES, watchUrl } from '../../data/mixtape';
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="pg-section sideb" id="side-b" aria-label="Tapes and player" data-sideb>
  <div class="sideb__grid">
    <div class="sideb__copy">
      <ol class="sideb__tapes" aria-label="Tapes">
        {TAPES.map((tape, i) => (
          <li>
            <button type="button" data-tape={i} aria-pressed="false" style={`--tape:${tape.label};--tape-ink:${tape.ink}`}>
              <b>{pad(i + 1)}</b><span>{tape.title}<small>{tape.note}</small></span>
            </button>
          </li>
        ))}
      </ol>
      <div class="sideb__keys" role="group" aria-label="Player">
        <button type="button" data-deck="eject" aria-label="Stop and eject">⏏</button>
        <button type="button" data-deck="rew" aria-label="Back one track">◀◀</button>
        <button type="button" data-deck="play" aria-label="Play or pause" class="is-play">▶</button>
        <button type="button" data-deck="ff" aria-label="Next track">▶▶</button>
        <button type="button" data-deck="flip" class="is-flip">Flip</button>
      </div>
    </div>
    <figure class="sideb__stage">
      <img class="sideb__still" src="/media/3d/walkman-still.webp" width="1280" height="800" alt="A blue and silver Sony Walkman with orange foam headphones, beside a pile of cassette tapes" loading="lazy" decoding="async" />
      <canvas class="sideb__canvas" data-deck-canvas aria-hidden="true"></canvas>
      <figcaption class="sideb__credit">3D model: <a href="https://sketchfab.com/3d-models/sony-walkman-6fcd4ae9f82844219ec465b49d4b69e0">“Sony Walkman”</a> by <a href="https://sketchfab.com/julius.j.bib">julius.j.bib</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, compressed for the web. The tapes are drawn by this site.</figcaption>
    </figure>
    <aside class="sideb__jcard" aria-live="polite" data-jcard>
      <p class="sideb__jcard-head"><span data-jcard-side>Side A</span><b data-jcard-title>No tape</b><small data-jcard-note>Pick a tape</small></p>
      <ol data-jcard-list><li>Pick a tape to see what’s on it.</li></ol>
      <div class="sideb__video" data-video>
        <div data-video-host></div>
        <p class="sideb__video-idle">Songs play here, from YouTube. It loads when you press play.</p>
      </div>
    </aside>
  </div>

  <details class="sideb__lists">
    <summary>All tracklists</summary>
    <div class="sideb__lists-grid">
      {TAPES.map((tape, i) => (
        <section aria-label={tape.title}>
          <h3><b>{pad(i + 1)}</b> {tape.title} <small>{tape.note}</small></h3>
          {(['a', 'b'] as const).map((side) => (
            <ol>
              {tape.side[side].map((track, k) => (
                <li><span>{side.toUpperCase()}{k + 1}</span>{track.id ? <a href={watchUrl(track.id)}>{track.title}</a> : track.title}{track.artist !== tape.note.split(' · ')[0] && <small> · {track.artist}</small>}</li>
              ))}
            </ol>
          ))}
        </section>
      ))}
    </div>
  </details>
  <script type="application/json" data-tapes set:html={JSON.stringify(TAPES)} />
</section>
