---
import { NAVIGATION } from '../../data/site';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header id="page-top" class="site-header" data-site-header tabindex="-1">
  <a class="site-signature" href="/" aria-label="Pranshul Chandhok, home">
    <strong>2600TH</strong>
    <span aria-hidden="true">/</span>
    <span>Pranshul Chandhok</span>
  </a>
  <nav class="site-nav" aria-label="Primary navigation">
    {NAVIGATION.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
</header>
