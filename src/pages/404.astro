---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/content-pages.css';
---

<BaseLayout
  title="Page not found"
  description="This page does not exist. Return to the portfolio of Pranshul Chandhok."
  canonical="/404.html"
  robots="noindex,follow"
>
  <div class="page-shell not-found-page">
    <header class="route-opening route-opening--404" data-route-opening>
      <div class="route-opening__positive" data-polarity="positive">
        <h1>Page not found</h1>
        <p class="route-opening__statement">This address doesn’t lead to a page on the site.</p>
      </div>
      <div class="route-opening__negative" data-polarity="negative">
        <p class="route-opening__context">Error 404</p>
        <p>You can return home, browse my <a href="/work/">projects</a>, or read the latest <a href="/notes/">notes</a>.</p>
        <p><a class="button-link button-link--primary" href="/">Return home ↗</a></p>
      </div>
    </header>
  </div>
</BaseLayout>
