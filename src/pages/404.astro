---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageOpening from '../components/site/PageOpening.astro';
import { getPublishedNotes } from '../data/notes';
import { getVisibleWork } from '../data/work-order';
import { CAREER_DOMAIN_META } from '../data/career-domains';
import '../styles/signal/pages.css';

// Every real line on the exchange, so the operator can suggest the nearest one.
const work = getVisibleWork(await getCollection('work'));
const notes = getPublishedNotes(await getCollection('notes'));
const routes = [
  { path: '/', title: 'Home' },
  { path: '/work/', title: 'Work' },
  { path: '/lab/', title: 'Lab' },
  { path: '/notes/', title: 'Notes' },
  { path: '/about/', title: 'About' },
  ...Object.entries(CAREER_DOMAIN_META).map(([key, meta]) => ({ path: `/work/domain/${key}/`, title: meta.label })),
  ...work.map((entry) => ({ path: `/work/${entry.data.slug}/`, title: entry.data.title })),
  ...notes.map((entry) => ({ path: `/notes/${entry.data.slug}/`, title: entry.data.title })),
  { path: '/lab/terminal/index.html', title: 'Ghost Terminal' },
  { path: '/lab/dwarkesh-jensen/index.html', title: 'Dwarkesh × Jensen' },
];
const defaults = routes.slice(0, 5);
const shell = (path: string) => `~${path.replace(/index\.html$/, '').replace(/\/$/, '') || ''}` || '~';
---

<SiteLayout
  title="Page not found"
  description="This page does not exist. Return to the portfolio of Pranshul Chandhok."
  canonical="/404.html"
  status="Intercept · 404"
  robots="noindex,follow"
>
  <div class="pg not-found-page">
    <PageOpening
      eyebrow={['404', 'Intercept']}
      path={[{ label: '404' }]}
      lede="The number you have dialed is not in service. Please check the address and try again, or take one of the lines the operator suggests."
      wave="tones"
    >
      <h1 slot="title">Page not <em>found.</em></h1>
      <div class="nf-op" data-intercept>
        <button type="button" class="nf-sit" data-nf-sit aria-label="Play the special information tones">
          <i></i><i></i><i></i>
          <span>913.8 · 1370.6 · 1776.7 Hz</span>
        </button>
        <p class="nf-dialed">You dialed <code data-nf-path>~/404</code></p>
        <p class="nf-label" id="nf-lines-title">The operator suggests</p>
        <ol class="nf-lines" aria-labelledby="nf-lines-title" data-nf-lines>
          {defaults.map((route, index) => (
            <li><a href={route.path} data-sfx="tick"><b>{index + 1}</b><span>{shell(route.path)}</span><i>{route.title}</i></a></li>
          ))}
        </ol>
        <form class="nf-prompt" data-nf-prompt>
          <label for="nf-path">guest@2600th:~$ cd</label>
          <input id="nf-path" name="path" type="text" list="nf-routes" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="work/kinema" />
          <button type="submit" class="sg-btn">Dial</button>
          <datalist id="nf-routes">{routes.map((route) => <option value={route.path.replace(/^\//, '').replace(/index\.html$/, '')}>{route.title}</option>)}</datalist>
        </form>
        <p class="nf-help" aria-hidden="true">Press <kbd>1</kbd>–<kbd>5</kbd> to redial a line.</p>
        <p class="nf-links">
          <a class="sg-btn" href="/" data-sfx="tick">Return home <span aria-hidden="true">→</span></a>
          <a class="sg-btn sg-btn--ghost" href="/work/" data-sfx="tick">Browse my projects</a>
          <a class="sg-btn sg-btn--ghost" href="/notes/" data-sfx="tick">Read the latest notes</a>
        </p>
        <script type="application/json" data-nf-routes set:html={JSON.stringify(routes)} />
      </div>
    </PageOpening>
  </div>
  <script>
    import { initIntercept } from '../signal/scenes/intercept.js';
    initIntercept();
  </script>
</SiteLayout>
