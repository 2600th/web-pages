---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../../components/shared/Breadcrumbs.astro';
import ProjectMedia from '../../components/work/ProjectMedia.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { getPublishedNotes, getNoteReadingTime, getOriginalSource, NOTE_TYPES } from '../../data/notes';
import '../../styles/content-pages.css';

export async function getStaticPaths() {
  const notes = getPublishedNotes(await getCollection('notes'));
  return notes.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'notes'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const showContents = data.type !== 'field-note' && sections.length >= 4;
const relatedWork = (await getCollection('work')).filter((work) => data.relatedWork.includes(work.data.slug));
const originalSource = getOriginalSource(data.canonicalUrl, data.slug);
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-IN', { day: '2-digit', month: 'long', year: 'numeric' }).format(date);
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.summary,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  mainEntityOfPage: `${SITE.url}/notes/${data.slug}/`,
  url: `${SITE.url}/notes/${data.slug}/`,
  image: new URL(data.ogImage, SITE.url).toString(),
  author: { '@id': `${SITE.url}/#person` },
  publisher: { '@id': `${SITE.url}/#person` },
  keywords: data.topics.join(', '),
}, {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Notes', item: `${SITE.url}/notes/` },
    { '@type': 'ListItem', position: 3, name: data.title, item: `${SITE.url}/notes/${data.slug}/` },
  ],
}];
---

<BaseLayout
  title={data.title}
  description={data.summary}
  canonical={`/notes/${data.slug}/`}
  image={data.ogImage}
  imageAlt={`${data.title} by Pranshul Chandhok`}
  imageWidth={1200}
  imageHeight={630}
  ogType="article"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ label: 'Notes', href: '/notes/' }, { label: data.title }]} />
  <article class="article-shell" data-reading-surface>
    <header class="article-shell__opening route-opening route-opening--article" data-route-opening>
      <div class="route-opening__positive" data-polarity="positive">
        <h1>{data.title}</h1>
      </div>
      <div class="route-opening__negative" data-polarity="negative">
        <p class="route-opening__context">{NOTE_TYPES[data.type]} · {formatDate(data.publishedAt)}</p>
        <p class="article-shell__summary">{data.summary}</p>
      </div>
    </header>
    <aside class="article-shell__meta">
      <p>Published <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>{data.updatedAt && data.updatedAt.valueOf() !== data.publishedAt.valueOf() && <><br />Updated <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time></>}</p>
      <p>{data.topics.join(' · ')}</p>
      <p>{getNoteReadingTime(entry.body ?? '')} min read</p>
    </aside>
    <div class="article-shell__content">
      {showContents && <details class="article-contents">
        <summary>On this page</summary>
        <nav aria-label="On this page">
          <ol>{sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol>
        </nav>
      </details>}
      {data.heroMedia && <ProjectMedia media={data.heroMedia} label="Article image" priority />}
      <div class="prose"><Content /></div>
      {(relatedWork.length > 0 || data.relatedLab.length > 0) && <nav class="article-shell__related" aria-label="Related work and experiments">
        <h2>From the work</h2>
        <ul>
          {relatedWork.map((work) => <li><a href={`/work/${work.data.slug}/`}>{work.data.title}</a></li>)}
          {data.relatedLab.map((lab) => <li><a href={lab.href}>{lab.title}</a></li>)}
        </ul>
      </nav>}
      <footer class="article-shell__source">
        <strong>{data.sourceAttribution}</strong>
        {originalSource && <p><a href={originalSource} target="_blank" rel="noopener noreferrer">Read the original post ↗</a></p>}
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .article-shell__related { margin-block-start: 3rem; padding-block-start: 1.5rem; border-top: 1px solid var(--line); }
  .article-shell__related ul { display: flex; flex-wrap: wrap; gap: 0.8rem 1.8rem; padding: 0; list-style: none; }
  .article-shell__related a { display: inline-block; padding-block: 0.5rem; }
  .article-contents { margin-bottom: 2rem; padding-block: 0.75rem; border-block: 1px solid var(--line); }
  .article-contents summary { width: fit-content; min-height: 2.75rem; padding-block: 0.5rem; color: var(--warm); cursor: pointer; font-weight: 650; }
  .article-contents ol { margin: 0.5rem 0 0; padding-left: 1.5rem; }
  .article-contents li { padding-left: 0.25rem; }
  .article-contents a { display: inline-block; padding-block: 0.55rem; color: var(--muted); line-height: 1.45; }
  .article-shell :global(.prose h2) { margin-block: 2.8rem 1rem; font-size: var(--type-article); max-width: 28ch; scroll-margin-top: 1.5rem; }
  .article-shell :global(.prose .table-scroll) { margin-block: 2rem; padding-bottom: 0.5rem; scrollbar-color: var(--gold) var(--velvet-soft); }
  .article-shell :global(.prose table) { width: 100%; table-layout: auto; border-collapse: collapse; margin-block: 0; font-size: 1rem; line-height: 1.5; }
  .article-shell :global(.prose th), .article-shell :global(.prose td) { padding: 0.8rem 0.75rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); overflow-wrap: normal; }
  .article-shell :global(.prose th) { color: var(--warm); }
  .article-shell :global(.prose pre) { max-width: 100%; overflow-x: auto; padding: 1.2rem; font-size: 1rem; line-height: 1.65; }
  .article-shell :global(.prose :not(pre) > code) { overflow-wrap: anywhere; }
  @media (max-width: 40rem) {
    .article-shell :global(.prose .table-scroll table) { min-width: 42rem; }
    .article-shell :global(.prose th), .article-shell :global(.prose td) { padding: 0.75rem; }
  }
</style>
