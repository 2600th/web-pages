---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageOpening from '../../components/site/PageOpening.astro';
import Transmissions from '../../components/site/Transmissions.astro';
import { getPublishedNotes, NOTE_TYPES } from '../../data/notes';
import '../../styles/signal/pages.css';

const notes = getPublishedNotes(await getCollection('notes'));
const types = (Object.keys(NOTE_TYPES) as (keyof typeof NOTE_TYPES)[]).map((key) => ({ key, label: NOTE_TYPES[key], count: notes.filter((note) => note.data.type === key).length }));
---

<SiteLayout
  title="Notes from the workbench"
  description="What I’m learning while building AI products, experimenting with browser graphics, and trying new tools. Notes by Pranshul Chandhok."
  canonical="/notes/"
>
  <div class="pg notes-page">
    <PageOpening
      eyebrow={['05', 'Transmissions']}
      path={[{ label: 'notes' }]}
      lede="What I’m learning as I build, test and occasionally break things. Field notes capture one observation, teardowns examine implementation choices, and essays argue a product point from the work."
      readout={[['Notes', `<b>${String(notes.length).padStart(2, '0')}</b> published`], ['Latest', `<b>${new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(notes[0].data.publishedAt)}</b>`], ['Feed', '<a href="/rss.xml">RSS</a>']]}
      wave="sine"
    >
      <h1 slot="title">Notes from the <em>workbench.</em></h1>
    </PageOpening>

    <div class="note-types" role="group" aria-label="Filter notes by type" data-note-filter>
      <button type="button" aria-pressed="true" data-note-filter-type="all" data-sfx="tick">All <b>{notes.length}</b></button>
      {types.map((type) => <button type="button" aria-pressed="false" data-note-filter-type={type.key} data-sfx="tick">{type.label}s <b>{type.count}</b></button>)}
    </div>
    <p class="sr-only" aria-live="polite" data-note-status></p>

    <section class="pg-notes" aria-label="All notes">
      <Transmissions notes={notes} detailed />
    </section>
  </div>

  <script>
    const root = document.querySelector<HTMLElement>('[data-note-filter]');
    const items = [...document.querySelectorAll<HTMLElement>('[data-transmissions] > li')];
    const status = document.querySelector<HTMLElement>('[data-note-status]');
    root?.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-note-filter-type]');
      if (!button) return;
      const type = button.dataset.noteFilterType;
      root.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      let visible = 0;
      items.forEach((item) => { item.hidden = type !== 'all' && item.dataset.noteType !== type; if (!item.hidden) visible += 1; });
      if (status) status.textContent = `${visible} ${visible === 1 ? 'note' : 'notes'} shown`;
    });
  </script>
</SiteLayout>
