---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/content-pages.css';

const builds = [
  {
    state: 'Companion',
    title: 'Dwarkesh × Jensen',
    description: 'An unofficial reading companion to the interview: 92 terms across eight sections, with searchable explanations and links to the original timestamps.',
    href: '/lab/dwarkesh-jensen/index.html',
  },
  {
    state: 'Active',
    title: 'Kinema',
    description: 'A third-person game with a level editor in the same browser tab. I’m using it to explore gameplay, graphics, and editing tools.',
    href: '/work/kinema/',
  },
  {
    state: 'Shipped',
    title: 'Web Ocean 3D',
    description: 'An interactive ocean with changing weather and a boat to pilot. I’m also working on how it loads and runs across devices.',
    href: '/work/web-ocean-3d/',
  },
  {
    state: 'Shipped',
    title: 'Safed Sagar',
    description: 'A compact fictional reconnaissance experience built and released in days as a browser flight experiment.',
    href: '/work/safed-sagar/',
  },
  {
    state: 'Source',
    title: 'GitHub',
    description: 'Repositories, 3D experiments, AI workflows, and the implementation behind this site.',
    href: 'https://github.com/2600th',
  },
  {
    state: 'Archived',
    title: 'Ghost Terminal',
    description: 'My earlier portfolio, built as a command-line interface. You can still explore it here.',
    href: '/lab/terminal/index.html',
  },
] as const;
---

<BaseLayout
  title="Experiments by Pranshul Chandhok"
  description="Games, browser graphics, and AI experiments I’m building to learn. Try the demos, read the code, or explore my earlier console portfolio."
  canonical="/lab/"
>
  <div class="lab-page">
    <header class="route-opening route-opening--lab lab-hero" data-route-opening>
      <div class="route-opening__positive" data-polarity="positive">
        <h1>Things I’m trying.</h1>
        <p class="route-opening__statement">Games, browser graphics, and ideas I wanted to test for myself.</p>
      </div>
      <div class="route-opening__negative" data-polarity="negative">
        <p class="route-opening__context">2600th / experiments</p>
        <p>I use these projects to learn a technology by working with it. Some are still rough. You can try them and look through the code.</p>
        <figure class="lab-hero__figure">
          <picture>
            <source media="(max-width: 42rem)" srcset="/media/work/kinema/inside-mobile.webp" />
            <img src="/media/work/kinema/inside.webp" alt="Kinema browser gameplay experiment with a live objective and spatial obstacle course" width="1600" height="900" />
          </picture>
          <figcaption><span>Current build</span><strong>Kinema / browser-native gameplay</strong></figcaption>
        </figure>
      </div>
    </header>

    <section class="build-index" aria-labelledby="build-index-title" data-build-ledger>
      <header>
        <h2 id="build-index-title">Try them yourself.</h2>
        <p>Open a hands-on experiment, explore a reading companion, or follow the code.</p>
      </header>
      <ol>
        {builds.map((build) => (
          <li data-build-row>
            <a href={build.href} target={build.href.startsWith('http') ? '_blank' : undefined} rel={build.href.startsWith('http') ? 'noopener' : undefined}>
              <span>{build.state}</span>
              <strong>{build.title}</strong>
              <span>{build.description}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>
