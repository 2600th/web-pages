---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageOpening from '../../components/site/PageOpening.astro';
import BuildFeature from '../../components/site/BuildFeature.astro';
import BuildCard from '../../components/site/BuildCard.astro';
import { BUILDS, FEATURED_BUILD } from '../../data/builds';
import '../../styles/signal/pages.css';

const all = [FEATURED_BUILD, ...BUILDS];
const liveCount = all.filter((build) => build.endpoints.some((end) => end.kind === 'live' || end.kind === 'site')).length;
const sourceCount = all.filter((build) => build.endpoints.some((end) => end.kind === 'src')).length;
---

<SiteLayout
  title="Experiments by Pranshul Chandhok"
  description="Games, browser graphics, and AI experiments I’m building to learn. Try the demos, read the code, or explore my earlier console portfolio."
  canonical="/lab/"
>
  <div class="pg lab-page">
    <PageOpening
      eyebrow={['04', 'Side channels']}
      path={[{ label: 'lab' }]}
      lede="Games, browser graphics and AI tools I wanted to test for myself. I learn a technology by shipping something with it. Some are still rough, all of them are public."
      readout={[['Builds', `<b>${String(all.length).padStart(2, '0')}</b>`], ['Live', `<b>${String(liveCount).padStart(2, '0')}</b> you can open now`], ['Source', `<b>${String(sourceCount).padStart(2, '0')}</b> open repositories`]]}
      wave="noise"
    >
      <h1 slot="title">Things I’m <em>trying.</em></h1>
    </PageOpening>

    <section class="lab-ledger" aria-labelledby="build-index-title" data-build-ledger>
      <h2 id="build-index-title" class="sr-only">Try them yourself</h2>
      <BuildFeature />
      <ul class="sg-builds">
        {BUILDS.map((build) => <BuildCard build={build} />)}
      </ul>
      <a class="sg-more" href="https://github.com/2600th" data-sfx="tick">Everything else on GitHub <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</SiteLayout>
