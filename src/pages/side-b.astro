---
// Side B: the other side of the tape. About is side A (the work); this is the music.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageOpening from '../components/site/PageOpening.astro';
import SideB from '../components/about/SideB.astro';
import '../styles/signal/pages.css';
import '../styles/signal/mixtape.css';
---

<SiteLayout
  title="Side B: music by Pranshul Chandhok"
  description="Side A is the work, Side B is the music: two tapes of Linkin Park, one of rock classics and one of the 2600 Hz line's own tones, played in a Walkman."
  canonical="/side-b/"
  status="Side B · tape idle"
>
  <div class="pg side-b-page">
    <PageOpening eyebrow={['B', 'Side B']} path={[{ label: 'about', href: '/about/' }, { label: 'side-b' }]} lede="Side A was the work. Side B is the music: two tapes of Linkin Park, one of rock classics, and one of the line’s own tones. Pick a tape and it drops into the Walkman." wave="sine" compact>
      <h1 slot="title">Side <em>B.</em></h1>
    </PageOpening>
    <SideB />
  </div>
  <script>
    import { initSideB } from '../signal/scenes/mixtape.js';
    initSideB();
  </script>
</SiteLayout>
