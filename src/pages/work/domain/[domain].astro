---
import { getCollection, type CollectionEntry } from 'astro:content';
import WorkList from '../../../components/work/WorkList.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageOpening from '../../../components/site/PageOpening.astro';
import Switchboard from '../../../components/work/Switchboard.astro';
import { CAREER_DOMAIN_META } from '../../../data/career-domains';
import { getPrioritizedWork } from '../../../data/work-order';
import type { CareerDomain } from '../../../content/evidence';
import '../../../styles/signal/pages.css';
import '../../../styles/signal/work.css';

export async function getStaticPaths() {
  const work = await getCollection('work');
  const domains = Object.entries(CAREER_DOMAIN_META).sort(([, a], [, b]) => a.order - b.order) as [CareerDomain, typeof CAREER_DOMAIN_META[CareerDomain]][];
  return domains.map(([domain]) => ({
    params: { domain },
    props: {
      domain,
      work: getPrioritizedWork(work.filter((entry) => entry.data.domains.includes(domain))),
    },
  }));
}

const domains = Object.entries(CAREER_DOMAIN_META).sort(([, a], [, b]) => a.order - b.order) as [CareerDomain, typeof CAREER_DOMAIN_META[CareerDomain]][];

interface Props {
  domain: CareerDomain;
  work: CollectionEntry<'work'>[];
}

const { domain, work } = Astro.props as Props;
const domainMeta = CAREER_DOMAIN_META[domain];
const allWork = getPrioritizedWork(await getCollection('work'));
// What this band actually covers: its years, its eras, and where it crosses other bands.
const firstYear = Math.min(...work.map((entry) => entry.data.yearStart));
const lastYear = Math.max(...work.map((entry) => entry.data.yearEnd ?? entry.data.yearStart));
const ERA_LABELS: Record<string, string> = { programmer: 'Programmer', founder: 'Founder', operator: 'Operator' };
const eraList = [...new Set(work.map((entry) => ERA_LABELS[entry.data.era] ?? entry.data.era))].join(' · ');
const crossings = domains
  .filter(([key]) => key !== domain)
  .map(([key, meta]) => ({ label: meta.label, count: work.filter((entry) => entry.data.domains.includes(key)).length }))
  .filter((cross) => cross.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 2);
---

<SiteLayout
  title={`${domainMeta.label} · Projects`}
  description={`${domainMeta.description} Explore my projects in this area and read about my contribution to each.`}
  canonical={`/work/domain/${domain}/`}
  status={`Band · ${({ games: 'Games', xr: 'XR', simulation: 'Simulation', robotics: 'Robotics', 'design-tech': 'Design tech', 'applied-ai': 'Applied AI' } as Record<string, string>)[domain] ?? domainMeta.label}`}
>
  <div class="pg work-archive" data-work-archive data-static-domain={domain}>
    <PageOpening
      eyebrow={['02', `Band · ${domainMeta.label}`]}
      path={[{ label: 'work', href: '/work/' }, { label: 'domain' }, { label: domain }]}
      lede={domainMeta.description}
      readout={[
        ['Lines', `<b>${String(work.length).padStart(2, '0')}</b> ${work.length === 1 ? 'project' : 'projects'}`],
        ['Active', `<b>${firstYear === lastYear ? firstYear : `${firstYear}–${lastYear}`}</b>`],
        ['Eras', eraList],
        ...(crossings.length ? [['Crosses', crossings.map((cross) => `${cross.label} <b>${cross.count}</b>`).join(' · ')] as [string, string]] : []),
      ]}
      wave="square"
      compact
    >
      <h1 slot="title">{domainMeta.label}</h1>
      <p class="sr-only">{work.length} relevant projects. My work in {domainMeta.label.toLowerCase()}, including the product and technical decisions behind each project.</p>
    </PageOpening>

    <Switchboard work={allWork} order={allWork} total={allWork.length} active={domain} />
    <noscript>
      <nav class="domain-filter-mobile-links" aria-label="Browse work domains">
        <a href="/work/">All domains</a>
        {domains.map(([key, meta]) => <a href={`/work/domain/${key}/`}>{meta.label}</a>)}
      </nav>
    </noscript>
    <label class="domain-filter-select pg-select" hidden>
      <span>Work domain</span>
      <select aria-label="Choose a work domain" data-domain-select>
        <option value="all">All domains</option>
        {domains.map(([key, meta]) => <option value={key} selected={key === domain}>{meta.label}</option>)}
      </select>
    </label>

    <p class="sr-only" aria-live="polite" data-work-status>{domainMeta.label}, {work.length} {work.length === 1 ? 'project' : 'projects'}</p>
    <section class="work-list-region" aria-labelledby="work-list-heading">
      <header>
        <div><h2 id="work-list-heading" data-work-heading>{domainMeta.label}</h2><span class="work-list-region__count" data-visible-count>{String(work.length).padStart(2, '0')}</span></div>
        <p data-work-description>Selected systems first, followed by the earlier archive.</p>
      </header>
      <WorkList work={work} uniform />
    </section>
  </div>

  <script>
    import { initSwitchboard } from '../../../signal/scenes/switchboard.js';
    initSwitchboard();
    const initStaticDomain = () => {
      document.querySelectorAll<HTMLElement>('[data-static-domain]').forEach((root) => {
        if (root.dataset.bound === 'true') return;
        root.dataset.bound = 'true';
        const select = root.querySelector<HTMLSelectElement>('[data-domain-select]');
        if (select) {
          select.addEventListener('change', () => {
            window.location.assign(select.value === 'all' ? '/work/' : `/work/domain/${select.value}/`);
          });
          root.querySelector<HTMLElement>('.domain-filter-select')?.removeAttribute('hidden');
        }
      });
    };
    initStaticDomain();
    document.addEventListener('astro:after-swap', initStaticDomain);
  </script>
</SiteLayout>
