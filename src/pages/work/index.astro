---
import { getCollection } from 'astro:content';
import WorkList from '../../components/work/WorkList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CAREER_DOMAIN_META } from '../../data/career-domains';
import type { CareerDomain } from '../../content/evidence';
import '../../styles/content-pages.css';

const work = (await getCollection('work')).sort((a, b) => a.data.careerOrder - b.data.careerOrder);
const domains = Object.entries(CAREER_DOMAIN_META).sort(([, a], [, b]) => a.order - b.order) as [CareerDomain, typeof CAREER_DOMAIN_META[CareerDomain]][];
---

<BaseLayout
  title="Career work"
  description="The public career archive of Pranshul Chandhok across games, XR, simulation, robotics, design technology, and applied AI."
  canonical="/work/"
>
  <div class="page-shell work-archive" data-work-archive>
    <header class="page-hero">
      <div>
        <p class="section-kicker">Work · public-first evidence</p>
        <h1>Career work</h1>
      </div>
      <div class="page-hero__aside">
        <p>Fifteen public records across the recurring systems, products, and questions that shaped the practice.</p>
        <p>Full cases go deep. Evidence notes stay deliberately concise where the public record is lighter.</p>
      </div>
    </header>

    <nav class="domain-filter" aria-label="Filter work by domain">
      <a href="/work/" data-domain-link="all" aria-current="page">All domains</a>
      {domains.map(([key, domain]) => <a href={`/work/?domain=${key}`} data-domain-link={key}>{domain.label}</a>)}
    </nav>

    <div class="work-domain-groups">
      {domains.map(([key, domain]) => {
        const entries = work.filter((entry) => entry.data.domains.includes(key));
        return (
          <section class="work-domain" data-work-domain={key} aria-labelledby={`domain-${key}`}>
            <header>
              <div><h2 id={`domain-${key}`}>{domain.label}</h2><span>{String(entries.length).padStart(2, '0')}</span></div>
              <p>{domain.description}</p>
            </header>
            <WorkList work={entries} />
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  const initWorkArchive = () => {
    document.querySelectorAll<HTMLElement>('[data-work-archive]').forEach((root) => {
      const requested = new URLSearchParams(location.search).get('domain');
      const sections = [...root.querySelectorAll<HTMLElement>('[data-work-domain]')];
      const valid = sections.some((section) => section.dataset.workDomain === requested);
      sections.forEach((section) => { section.hidden = valid && section.dataset.workDomain !== requested; });
      root.querySelectorAll<HTMLAnchorElement>('[data-domain-link]').forEach((link) => {
        const active = valid ? link.dataset.domainLink === requested : link.dataset.domainLink === 'all';
        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
    });
  };
  initWorkArchive();
  document.addEventListener('astro:after-swap', initWorkArchive);
</script>

<style>
  .domain-filter { display: flex; overflow-x: auto; border-block: 1px solid var(--line); }
  .domain-filter a { min-width: max-content; padding: 1rem 1.25rem; border-right: 1px solid var(--line); color: var(--text-muted); font-size: 0.76rem; font-weight: 680; text-decoration: none; }
  .domain-filter a[aria-current='page'] { background: var(--text); color: var(--surface); }
  .work-domain { padding-block: clamp(4rem, 8vw, 8rem); }
  .work-domain[hidden] { display: none; }
  .work-domain + .work-domain { border-top: 1px solid var(--line); }
  .work-domain > header { display: grid; grid-template-columns: 1fr minmax(16rem, 0.45fr); gap: 2rem; align-items: end; margin-bottom: 2.5rem; }
  .work-domain > header > div { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .work-domain h2 { max-width: 12ch; margin: 0; font-size: clamp(3rem, 7vw, 6rem); }
  .work-domain header span { color: var(--cobalt); font-size: 0.75rem; font-variant-numeric: tabular-nums; }
  .work-domain header p { max-width: 34ch; margin: 0; color: var(--text-muted); font-size: 0.85rem; }
  @media (max-width: 46rem) { .work-domain > header { grid-template-columns: 1fr; } }
</style>
