---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../../components/shared/Breadcrumbs.astro';
import EvidenceSources from '../../components/work/EvidenceSources.astro';
import ProjectMedia from '../../components/work/ProjectMedia.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import '../../styles/content-pages.css';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  url: `${SITE.url}/work/${data.slug}/`,
  image: new URL(data.seo.socialImage, SITE.url).toString(),
  creator: { '@id': `${SITE.url}/#person` },
  dateCreated: String(data.yearStart),
  keywords: data.disciplines.join(', '),
  citation: data.sources.map((source) => source.url),
}, {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Work', item: `${SITE.url}/work/` },
    { '@type': 'ListItem', position: 3, name: data.title, item: `${SITE.url}/work/${data.slug}/` },
  ],
}];
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  canonical={`/work/${data.slug}/`}
  image={data.seo.socialImage}
  imageAlt={data.heroMedia?.alt ?? `${data.title} by Pranshul Chandhok`}
  imageWidth={data.heroMedia?.width ?? 1600}
  imageHeight={data.heroMedia?.height ?? 900}
  ogType="article"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ label: 'Work', href: '/work/' }, { label: data.title }]} />
  <header class:list={['case-hero route-opening route-opening--case', { 'case-hero--long': data.title.length > 36 }]} data-route-opening>
    <div class="case-hero__positive" data-polarity="positive">
      <h1>{data.title}</h1>
    </div>
    <div class="case-hero__negative" data-polarity="negative">
      <p class="case-hero__context">{data.yearStart} · {data.status}</p>
      <p class="case-hero__summary">{data.summary}</p>
      <dl class="case-hero__meta">
        <div><dt>Role</dt><dd>{data.role}</dd></div>
        <div><dt>Period</dt><dd>{data.yearStart}{data.yearEnd ? `–${data.yearEnd}` : ''}</dd></div>
        <div><dt>Status</dt><dd>{data.status}</dd></div>
        <div><dt>Visibility</dt><dd>{data.visibility.replace('-', ' ')}</dd></div>
      </dl>
    </div>
    {data.heroMedia && <div class="case-hero__media"><ProjectMedia media={data.heroMedia} label={data.heroLabel ?? `${data.title} · public result`} priority /></div>}
  </header>

  {data.recordType !== 'evidence-note' ? (
    <div class="project-story">
      <section class="project-story__frame project-story__section" data-case-part="thesis" aria-labelledby="thesis-title">
        <div class="project-story__marker"><span>Case structure</span><strong>THESIS</strong></div>
        <div class="project-story__body">
          <div><h2 id="thesis-title">{data.out.thesis}</h2></div>
          <dl class="fact-grid">
            <div><dt>For</dt><dd>{data.out.audience}</dd></div>
            <div><dt>Public result</dt><dd>{data.out.outcome}</dd></div>
          </dl>
          <ProjectMedia media={data.out.media} label="Out · result" />
        </div>
      </section>

      <section class="project-story__frame project-story__section" data-case-part="contribution" aria-labelledby="contribution-title">
        <div class="project-story__marker"><span>Case structure</span><strong>CONTRIBUTION</strong></div>
        <div class="project-story__body">
          <div><h2 id="contribution-title">{data.near.experience}</h2></div>
          <dl class="fact-grid">
            <div><dt>Contribution</dt><dd>{data.near.contribution}</dd></div>
          </dl>
          <ProjectMedia media={data.near.media} label="Near · experience" />
        </div>
      </section>

      <section class="project-story__frame project-story__section" data-case-part="system" aria-labelledby="system-title">
        <div class="project-story__marker"><span>Case structure</span><strong>SYSTEM</strong></div>
        <div class="project-story__body">
          <div><h2 id="system-title">What had to be true underneath.</h2></div>
          <dl class="fact-grid">
            <div><dt>System</dt><dd>{data.near.system}</dd></div>
            <div><dt>Key decisions</dt><dd><ul>{data.inside.decisions.map((item) => <li>{item}</li>)}</ul></dd></div>
            <div><dt>Constraints</dt><dd><ul>{data.inside.constraints.map((item) => <li>{item}</li>)}</ul></dd></div>
          </dl>
          <ProjectMedia media={data.inside.media} label="Inside · system" />
        </div>
      </section>

      <section class="project-story__frame project-story__section" data-case-part="evidence" aria-labelledby="evidence-record-title">
        <div class="project-story__marker"><span>Case structure</span><strong>EVIDENCE</strong></div>
        <div class="project-story__body">
          <div class="project-story__evidence"><h2 id="evidence-record-title">Evidence record</h2><ul>{data.inside.evidence.map((item) => <li>{item}</li>)}</ul></div>
          <div class="prose"><Content /></div>
        </div>
      </section>

      <div data-case-part="sources"><EvidenceSources sources={data.sources} reviewedEvidence={data.reviewedEvidence} /></div>
    </div>
  ) : (
    <div class="project-story">
      <section class="project-story__frame project-story__section" data-case-part="evidence" aria-labelledby="evidence-note-title">
        <div class="project-story__marker"><span>Case structure</span><strong>EVIDENCE</strong></div>
        <div class="project-story__body">
          <div><h2 id="evidence-note-title">{data.title}, in the public record.</h2></div>
          <div class="prose"><Content /></div>
        </div>
      </section>
      <div data-case-part="sources"><EvidenceSources sources={data.sources} reviewedEvidence={data.reviewedEvidence} /></div>
    </div>
  )}
</BaseLayout>
