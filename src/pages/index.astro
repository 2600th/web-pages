---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VelvetHero from '../components/home/VelvetHero.astro';
import VelvetHomeSections from '../components/home/VelvetHomeSections.astro';
import { getFeaturedWork } from '../data/work-order';
import { getHomepageNotes } from '../data/notes';

const selectedWork = getFeaturedWork(await getCollection('work'));
const notes = getHomepageNotes(await getCollection('notes'));
---

<BaseLayout
  bodyClass="home-page"
  title="Pranshul Chandhok (2600th) | Product, AI and Realtime Systems"
  description="Product and technology leader building applied AI, realtime 3D, design software, XR, and game systems. Selected work, technical teardowns, and independent experiments."
>
  <VelvetHero />
  <VelvetHomeSections work={selectedWork} notes={notes} />
</BaseLayout>
