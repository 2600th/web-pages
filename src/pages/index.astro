---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PositiveNegativeHero from '../components/home/PositiveNegativeHero.astro';
import SignalWork from '../components/home/SignalWork.astro';
import ProofLine from '../components/home/ProofLine.astro';
import PublicBuild from '../components/home/PublicBuild.astro';
import RecentThinking from '../components/home/RecentThinking.astro';
import ConversationClose from '../components/home/ConversationClose.astro';

const selectedSlugs = ['blocks-inco-ai', 'ira-vr', 'enterprise-immersive-systems'];
const allWork = await getCollection('work');
const selectedWork = selectedSlugs
  .map((slug) => allWork.find((entry) => entry.data.slug === slug))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));
const notes = await getCollection('notes', ({ data }) => !data.draft);
---

<BaseLayout
  bodyClass="home-page"
  title="Pranshul Chandhok — Operator, advisor, and builder"
  description="Pranshul Chandhok builds emerging technology into useful products across applied AI, real-time 3D, XR, games, simulation, and design technology."
>
  <PositiveNegativeHero />
  <SignalWork work={selectedWork} />
  <ProofLine />
  <PublicBuild />
  <RecentThinking notes={notes} />
  <ConversationClose />
</BaseLayout>
