---
import RecognitionLedger from '../components/home/RecognitionLedger.astro';
import ConversationClose from '../components/home/ConversationClose.astro';
import LivingWordmark from '../components/home/LivingWordmark.astro';
import MotionProof from '../components/home/MotionProof.astro';
import CareerAtlas from '../components/home/CareerAtlas.astro';
import RecentThinking from '../components/home/RecentThinking.astro';
import ThreeDistances from '../components/home/ThreeDistances.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredWork = await getCollection('work', ({ data }) => data.featuredOrder > 0);
const careerWork = await getCollection('work');
const notes = await getCollection('notes', ({ data }) => !data.draft);
---

<!--
THESIS: Pranshul's name is the interface; real project media and authored depth replace the generic portfolio hero, resume grid, and decorative technology theatre.
OWN-WORLD: Mineral white, optical black, and one cobalt signal; monumental variable grotesk lettering, hard image apertures, exact captions, and no card chrome.
STORY: Visitors identify a hands-on operator, encounter proof through real work, understand the long AI-plus-spatial arc, and start a relevant conversation.
FIRST VIEWPORT: PRANSHUL CHANDHOK occupies the field; selected letters hold project imagery, positioning sits upper-right, and the conversation action anchors lower-left.
FORM: Living Wordmark leads, Motion Proof establishes evidence, Three Distances structures case studies, and Career Atlas carries the archive; B-led hybrid, seed 8f453d22.
-->

<BaseLayout bodyClass="home-page">
  <LivingWordmark />
  <MotionProof />
  <RecognitionLedger />
  <ThreeDistances work={featuredWork} />
  <CareerAtlas work={careerWork} />
  <RecentThinking notes={notes} />
  <ConversationClose />
</BaseLayout>
